module Bench.ListSum:

  part build(n: Int) -> List[Int]:
    requires n >= 0
    measure n
    match n:
      0 -> yield []
      _ -> yield n :: build(n - 1)

  part sum(xs: List[Int]) -> Int:
    match xs:
      []     -> yield 0
      h :: t -> yield h + sum(t)

  part repeat(k: Int, xs: List[Int], acc: Int) -> Int:
    requires k >= 0
    measure k
    match k:
      0 -> yield acc
      _ -> yield repeat(k - 1, xs, acc + sum(xs))

  part main() -> Int via IO:
    let xs = build(2000)
    yield IO.print(repeat(30000, xs, 0))
