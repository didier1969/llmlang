module Isqrt:

  part isqrt_bisect(n: Int, lo: Int, hi: Int) -> Int:
    requires n >= 1, lo >= 1, lo < hi, lo * lo <= n, n < hi * hi
    ensures result >= 0, result * result <= n, (result + 1) * (result + 1) > n
    measure hi - lo
    let mid = lo + (hi - lo) div 2
    match hi - lo <= 1:
      true -> yield lo
      false ->
        match mid * mid <= n:
          true -> yield isqrt_bisect(n, mid, hi)
          false -> yield isqrt_bisect(n, lo, mid)

  part isqrt(n: Int) -> Int:
    requires n >= 0
    ensures result >= 0, result * result <= n, (result + 1) * (result + 1) > n
    match n:
      0 -> yield 0
      _ -> yield isqrt_bisect(n, 1, n + 1)
