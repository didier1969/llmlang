module IntSqrt:

  part isqrt_helper(n: Int, lo: Int, hi: Int) -> Int:
    requires n >= 0, lo >= 0, lo <= hi
    requires lo*lo <= n
    requires (hi+1)*(hi+1) > n
    ensures result >= 0, result*result <= n, (result+1)*(result+1) > n
    measure hi - lo
    match hi - lo:
      0 -> yield lo
      _ ->
        let mid = lo + (hi - lo) div 2 + 1
        match mid <= n div mid:
          true  -> yield isqrt_helper(n, mid, hi)
          _     -> yield isqrt_helper(n, lo, mid - 1)

  part isqrt(n: Int) -> Int:
    requires n >= 0
    ensures result >= 0, result*result <= n, (result+1)*(result+1) > n
    yield isqrt_helper(n, 0, n)
