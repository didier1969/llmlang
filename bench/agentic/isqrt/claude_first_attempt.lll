module Isqrt:

  part isqrt(n: Int) -> Int:
    requires n >= 0
    ensures result >= 0
    ensures result * result <= n
    ensures (result + 1) * (result + 1) > n
    yield isqrt_between(n, 0, n + 1)

  part isqrt_between(n: Int, lo: Int, hi: Int) -> Int:
    requires n >= 0
    requires lo >= 0
    requires lo < hi
    requires lo * lo <= n
    requires hi * hi > n
    ensures result >= 0
    ensures result * result <= n
    ensures (result + 1) * (result + 1) > n
    measure hi - lo
    match hi - lo:
      1 -> yield lo
      _ ->
        let mid = lo + (hi - lo) div 2
        yield if mid <= n div mid then isqrt_between(n, mid, hi) else isqrt_between(n, lo, mid)
