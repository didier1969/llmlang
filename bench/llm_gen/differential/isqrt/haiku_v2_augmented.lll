module isqrt:

  part isqrt(n: Int) -> Int:
    requires n >= 0
    ensures result * result <= n and n < (result + 1) * (result + 1)
    match n:
      0 -> yield 0
      _ -> yield search(n, 0, n + 1)

  part search(n: Int, lo: Int, hi: Int) -> Int:
    requires n > 0 and lo >= 0 and hi > lo
    requires lo * lo <= n
    requires hi * hi > n
    ensures result * result <= n and n < (result + 1) * (result + 1)
    measure hi - lo
    match hi - lo:
      1 -> yield lo
      _ ->
        let mid = lo + (hi - lo) div 2
        match mid - (n div mid):
          d when d <= 0 -> yield search(n, mid, hi)
          _ -> yield search(n, lo, mid)
