module Isqrt:

  part isqrt_helper(n: Int, r: Int) -> Int:
    requires n >= 0, r >= 0, r * r <= n
    ensures result * result <= n and n < (result + 1) * (result + 1)
    measure n - r * r
    match (r + 1) * (r + 1) <= n:
      v when v -> yield isqrt_helper(n, r + 1)
      _ -> yield r

  part isqrt(n: Int) -> Int:
    requires n >= 0
    ensures result * result <= n and n < (result + 1) * (result + 1)
    let r = isqrt_helper(n, 0)
    yield r
