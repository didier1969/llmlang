import "db_json.lll"

depends rusqlite "0.39.0" features "bundled"

module Std.Db:

  # Verified SQLite persistence, wave-3 slice-2 (REQ-LLL-066, DEC-LLL-064). The compiler
  # emits a built-in `lll_db_runtime` (src/codegen.rs `emit_db_runtime`) — a process-global
  # `handle -> rusqlite::Connection` registry — and each op below binds to it across the FFI
  # frontier, marshalling with the SAME machinery as the serde_json bridge (REQ-LLL-056/061):
  #   - a SQL string is a `List[Int]` of codepoints (DEC-LLL-030), crossed to Rust `&str`;
  #   - `query` returns a `serde_json::Value` mapped BY NAME into the shared `Json` ADT.
  #
  # DEC-LLL-066 étape 3 : le `Json` ADT + les destructeurs purs (unarr/unnum/nth/count/
  # cell_int) sont le CONTRAT NORMALISÉ, extrait dans std/db_json.lll et importé ci-dessus —
  # PARTAGÉ à l'identique avec le backend Postgres (std/db_pg.lll). Ce fichier ne garde que la
  # PARTIE backend-spécifique : l'effet `Db` bindé aux chemins `lll_db_runtime::…`. Swapper
  # vers Postgres = remplacer l'import de CE fichier par `std/db_pg.lll` (même effet `Db`,
  # même contrat `Json`, mêmes destructeurs) — l'interchangeabilité au niveau module.
  #
  # DB faults are fail-stop (DEC-LLL-026: abort loudly, never silently corrupt the books);
  # errors-as-values and bound query parameters are logged follow-ups. `rusqlite` (+ le
  # `serde_json` du contrat) est déclaré ICI : le backend PORTE sa dépendance, et les
  # `depends` se propagent transitivement via l'import — donc un programme n'a qu'à importer
  # ce fichier, sans redéclarer aucune crate. Swapper vers Postgres = importer std/db_pg.lll
  # à la place ; la dépendance `postgres` suit automatiquement (le swap tient en 1 ligne).

  effect Db:
    open(List[Int]) -> Int = extern "lll_db_runtime::open" as (str) -> i64
    exec(Int, List[Int]) -> Int = extern "lll_db_runtime::exec" as (i64, str) -> i64
    query(Int, List[Int]) -> Json = extern "lll_db_runtime::query" as (i64, str) -> enum serde_json::Value [ Null -> JNull, Bool -> JBool, String -> JStr, Number -> JNum, Array -> JArr ]
    begin(Int) -> Int = extern "lll_db_runtime::begin"
    commit(Int) -> Int = extern "lll_db_runtime::commit"
    rollback(Int) -> Int = extern "lll_db_runtime::rollback"
