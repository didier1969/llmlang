import "db_json.lll"

depends rusqlite "0.39.0" features "bundled"

module Std.Db:

  # Verified SQLite persistence.
  #
  # Crossing the foreign frontier: a SQL string is a `List[Int]` of codepoints and reaches
  # Rust as `&str`; `query` returns a `serde_json::Value` mapped by name into the `Json` ADT
  # that `db_json.lll` defines. That ADT and its pure destructors are the backend-neutral
  # contract; this file holds only what is specific to SQLite — the `Db` effect bound to the
  # compiler's built-in `lll_db_runtime`, a process-global registry of open connections.
  #
  # Swapping to PostgreSQL is one import line: `std/db_pg.lll` declares the same `Db` effect
  # over the same `Json` contract, and carries its own `postgres` dependency, which
  # propagates through the import — a program never names a crate. Importing both backends
  # is a compile error, because the effect name collides, so the swap is exclusive by
  # construction rather than by convention.
  #
  # Two limits worth knowing before you use this. A database fault aborts the program rather
  # than returning a value: books are never silently corrupted, but there is no recovery
  # path. And query parameters are not bound — SQL is assembled as text, so this is safe for
  # trusted input only.

  effect Db:
    open(List[Int]) -> Int = extern "lll_db_runtime::open" as (str) -> i64
    exec(Int, List[Int]) -> Int = extern "lll_db_runtime::exec" as (i64, str) -> i64
    query(Int, List[Int]) -> Json = extern "lll_db_runtime::query" as (i64, str) -> enum serde_json::Value [ Null -> JNull, Bool -> JBool, String -> JStr, Number -> JNum, Array -> JArr ]
    begin(Int) -> Int = extern "lll_db_runtime::begin"
    commit(Int) -> Int = extern "lll_db_runtime::commit"
    rollback(Int) -> Int = extern "lll_db_runtime::rollback"
