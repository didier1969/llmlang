import "db_json.lll"

depends postgres "0.19.10"

module Std.DbPg:

  # Verified PostgreSQL persistence — the twin of `std/db.lll`, deliberately identical in
  # contract: same operation names, same signatures, same `Json` ADT from `db_json.lll`,
  # same destructors.
  #
  # That is what makes the swap one line. A module persisting through SQLite moves to
  # PostgreSQL by importing this file instead, and the proved domain code does not change;
  # only the argument to `open` differs, being backend-specific configuration. Both effects
  # are named `Db`, so importing both is a compile error — the compiler makes the swap
  # mutually exclusive rather than trusting the programmer to pick one.
  #
  # `open` takes an explicit libpq connection string (`host=… port=… user=… dbname=…`),
  # where SQLite took a file path. A database fault aborts rather than returning a value.

  effect Db:
    open(List[Int]) -> Int = extern "lll_pg_runtime::open" as (str) -> i64
    exec(Int, List[Int]) -> Int = extern "lll_pg_runtime::exec" as (i64, str) -> i64
    query(Int, List[Int]) -> Json = extern "lll_pg_runtime::query" as (i64, str) -> enum serde_json::Value [ Null -> JNull, Bool -> JBool, String -> JStr, Number -> JNum, Array -> JArr ]
    begin(Int) -> Int = extern "lll_pg_runtime::begin"
    commit(Int) -> Int = extern "lll_pg_runtime::commit"
    rollback(Int) -> Int = extern "lll_pg_runtime::rollback"
