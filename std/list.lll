module Std.List:

  # ---- stdlib, written IN llmlang and verified by the real Z3 pipeline ----
  # (REQ-LLL-003 ; made generic over the element type in wave 4, REQ-LLL-007).
  # Structural combinators are `List[a]` — ONE proof serves every element type.
  # Functions that are inherently about Int (arithmetic/order) stay `List[Int]`.

  part len(xs: List[a]) -> Int:
    ensures result >= 0
    match xs:
      []     -> yield 0
      h :: t -> yield 1 + len(t)

  part append(xs: List[a], ys: List[a]) -> List[a]:
    match xs:
      []     -> yield ys
      h :: t -> yield h :: append(t, ys)

  part rev_acc(xs: List[a], acc: List[a]) -> List[a]:
    match xs:
      []     -> yield acc
      h :: t -> yield rev_acc(t, h :: acc)

  part reverse(xs: List[a]) -> List[a]:
    yield rev_acc(xs, [])

  part contains(xs: List[a], v: a) -> Bool:
    match xs:
      []     -> yield false
      h :: t ->
        match h:
          w when w == v -> yield true
          _             -> yield contains(t, v)

  part take(xs: List[a], n: Int) -> List[a]:
    match xs:
      []     -> yield []
      h :: t ->
        match n:
          m when m <= 0 -> yield []
          _             -> yield h :: take(t, n - 1)

  part drop(xs: List[a], n: Int) -> List[a]:
    match xs:
      []     -> yield xs
      h :: t ->
        match n:
          m when m <= 0 -> yield xs
          _             -> yield drop(t, n - 1)

  part nth(xs: List[a], i: Int, d: a) -> a:
    match xs:
      []     -> yield d
      h :: t ->
        match i:
          0 -> yield h
          _ -> yield nth(t, i - 1, d)

  # higher-order, type-changing: one proof over abstract element sorts (a, b)
  part map(f: (a) -> b, xs: List[a]) -> List[b]:
    match xs:
      []     -> yield []
      h :: t -> yield f(h) :: map(f, t)

  # ---- Int-specific: arithmetic / order ----

  part sum(xs: List[Int]) -> Int:
    match xs:
      []     -> yield 0
      h :: t -> yield h + sum(t)

  part max2(a: Int, b: Int) -> Int:
    ensures result >= a, result >= b, result == a or result == b
    match a:
      v when v >= b -> yield a
      _             -> yield b

  part min2(a: Int, b: Int) -> Int:
    ensures result <= a, result <= b, result == a or result == b
    match a:
      v when v <= b -> yield a
      _             -> yield b

  part maximum(xs: List[Int], d: Int) -> Int:
    ensures result >= d
    match xs:
      []     -> yield d
      h :: t ->
        let m = maximum(t, d)
        yield max2(h, m)

  part minimum(xs: List[Int], d: Int) -> Int:
    ensures result <= d
    match xs:
      []     -> yield d
      h :: t ->
        let m = minimum(t, d)
        yield min2(h, m)
