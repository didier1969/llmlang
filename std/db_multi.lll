import "db_json.lll"

depends rusqlite "0.39.0" features "bundled"
depends postgres "0.19.10"

module Std.DbMulti:

  # Verified persistence with the backend chosen at RUNTIME instead of at build time.
  #
  # `std/db.lll` and `std/db_pg.lll` pick a backend by which file you import, and the two
  # cannot coexist — their `effect Db` declarations collide. This module binds instead to a
  # unified runtime whose handle carries the backend with it, selected by the scheme of the
  # connection string:
  #
  #   Db.open("sqlite::memory:")   SQLite; what follows `sqlite:` is the rusqlite path,
  #                                either `:memory:` or a file
  #   Db.open("host=… dbname=…")   PostgreSQL; any string WITHOUT the `sqlite:` prefix
  #
  # Two `open` calls with different schemes give two live backends inside one program, which
  # the import-level swap cannot express at all.
  #
  # The contract is unchanged from the single-backend modules, so the proved domain code is
  # identical either way. The cost of deciding late is that BOTH crates are always linked:
  # a program that will only ever talk to SQLite still carries the PostgreSQL driver.

  effect Db:
    open(List[Int]) -> Int = extern "lll_db_multi_runtime::open" as (str) -> i64
    exec(Int, List[Int]) -> Int = extern "lll_db_multi_runtime::exec" as (i64, str) -> i64
    query(Int, List[Int]) -> Json = extern "lll_db_multi_runtime::query" as (i64, str) -> enum serde_json::Value [ Null -> JNull, Bool -> JBool, String -> JStr, Number -> JNum, Array -> JArr ]
    begin(Int) -> Int = extern "lll_db_multi_runtime::begin"
    commit(Int) -> Int = extern "lll_db_multi_runtime::commit"
    rollback(Int) -> Int = extern "lll_db_multi_runtime::rollback"
