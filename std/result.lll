module Std.Result:

  # Errors as values: a computation yields `Ok(a)` or `Err(e)`.
  #
  # `Ok` and `Err` reuse the names of the standard prelude's constructors on purpose, and do
  # not shadow them: every use lowers fully qualified, so importing this module leaves the
  # prelude's own constructors reachable.
  type Result[a, e] = Ok(a) | Err(e)

  part is_ok(r: Result[a, e]) -> Bool:
    match r:
      Ok(x)  -> yield true
      Err(y) -> yield false

  part is_err(r: Result[a, e]) -> Bool:
    match r:
      Ok(x)  -> yield false
      Err(y) -> yield true

  part ok_or(r: Result[a, e], d: a) -> a:
    match r:
      Ok(x)  -> yield x
      Err(y) -> yield d

  part map_ok(f: (a) -> b, r: Result[a, e]) -> Result[b, e]:
    match r:
      Ok(x)  -> yield Ok(f(x))
      Err(y) -> yield Err(y)
