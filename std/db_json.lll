depends serde_json "1.0.150"

module Std.DbJson:

  # The backend-neutral contract for verified persistence: the `Json` ADT that a `query`
  # marshals into, plus the pure destructors that read it. Every backend imports this one
  # file, so the domain code above them does not change when the backend does.
  #
  # A query result is an ARRAY OF ROWS; each row an ARRAY OF SCALAR CELLS in column order.
  # Rows are positional, not named — there is no marshalling from a JSON object, so a cell
  # is reached by index, never by column name.

  type Json = JNull | JBool(Bool) | JStr(List[Int]) | JNum(Int) | JArr(List[Json])

  # Total: any shape that is not an array reads as the empty list rather than failing.
  part unarr(j: Json) -> List[Json]:
    match j:
      JArr(xs) -> yield xs
      JNull    -> yield []
      JBool(b) -> yield []
      JStr(s)  -> yield []
      JNum(n)  -> yield []

  # A non-numeric cell yields a distinct negative sentinel per shape, so a schema that
  # drifted under the query is visible instead of reading as a silent 0.
  #
  # The sentinels are NOT disjoint from real data: a column genuinely holding -1 is
  # indistinguishable from a NULL one. Where a negative value is legitimate, match on the
  # `Json` shape yourself rather than going through this.
  part unnum(j: Json) -> Int:
    match j:
      JNum(n)  -> yield n
      JNull    -> yield 0 - 1
      JBool(b) -> yield 0 - 2
      JStr(s)  -> yield 0 - 3
      JArr(xs) -> yield 0 - 4

  # 0-based; an index past the end yields JNull rather than failing.
  part nth(xs: List[Json], i: Int) -> Json:
    match xs:
      []     -> yield JNull
      h :: t ->
        match i == 0:
          true  -> yield h
          false -> yield nth(t, i - 1)

  part count(rows: List[Json]) -> Int:
    match rows:
      []     -> yield 0
      h :: t -> yield 1 + count(t)

  part cell_int(row: Json, col: Int) -> Int:
    yield unnum(nth(unarr(row), col))
