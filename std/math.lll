module Std.Math:

  # ---- verified integer math, written IN llmlang (REQ-LLL-003) ----
  # Every function is proved by the real Z3 pipeline. `Int` is exact and unbounded
  # (DEC-LLL-077), so `pow`/`factorial` return their true value at any size — no
  # overflow, no ceiling. `abs` carries `example` clauses, which `lll test` executes,
  # pinning model≡binary concordance (DEC-LLL-020).

  # Absolute value. `example` clauses are RUN by `lll test`.
  part abs(x: Int) -> Int:
    ensures result >= 0
    ensures result == x or result == 0 - x
    example abs(0 - 5) == 5
    example abs(7) == 7
    match x:
      v when v >= 0 -> yield x
      _             -> yield 0 - x

  # Sign as -1 / 0 / +1. The `ensures` PINS the value per case (not just a range), which is
  # what lets the `example` clauses discharge: an example is proved from the CONTRACT, so the
  # contract must determine the result at the example's arguments.
  part sign(x: Int) -> Int:
    ensures (x > 0 and result == 1) or (x < 0 and result == 0 - 1) or (x == 0 and result == 0)
    example sign(0 - 3) == 0 - 1
    example sign(0) == 0
    example sign(9) == 1
    match x:
      v when v > 0 -> yield 1
      v when v < 0 -> yield 0 - 1
      _            -> yield 0

  # Greatest common divisor (Euclid). `measure b` proves termination: `a mod b < b`
  # for `b > 0` (Euclidean `mod` is in `[0, b)`), so the recursion strictly decreases.
  part gcd(a: Int, b: Int) -> Int:
    requires a >= 0, b >= 0
    measure b
    ensures result >= 0
    match b:
      0 -> yield a
      _ -> yield gcd(b, a mod b)

  # Integer power, `base^exp`. Exact — `pow(2, 100)` is the true 31-digit value.
  part pow(base: Int, exp: Int) -> Int:
    requires exp >= 0
    measure exp
    match exp:
      0 -> yield 1
      _ -> yield base * pow(base, exp - 1)

  # Factorial. Exact — `factorial(25)` overflows i64 by ~1680× and is still correct.
  part factorial(n: Int) -> Int:
    requires n >= 0
    measure n
    ensures result >= 1
    match n:
      0 -> yield 1
      _ -> yield n * factorial(n - 1)

  # Clamp `x` into the inclusive interval `[lo, hi]`. The `ensures` PINS the result
  # per case (like `sign`), so the `example` clauses discharge from the contract.
  part clamp(x: Int, lo: Int, hi: Int) -> Int:
    requires lo <= hi
    ensures result >= lo and result <= hi
    ensures (x < lo and result == lo) or (x > hi and result == hi) or (lo <= x and x <= hi and result == x)
    example clamp(5, 0, 10) == 5
    example clamp(0 - 3, 0, 10) == 0
    example clamp(42, 0, 10) == 10
    match x:
      v when v < lo -> yield lo
      v when v > hi -> yield hi
      _             -> yield x

  # Even / odd predicates. Euclidean `mod` (DEC-LLL-026) puts `n mod 2` in {0, 1},
  # so the `_` arm is exactly the complementary case — the contract determines `result`.
  part even(n: Int) -> Bool:
    ensures result == (n mod 2 == 0)
    example even(4)
    example even(3) == false
    match n mod 2:
      0 -> yield true
      _ -> yield false

  part odd(n: Int) -> Bool:
    ensures result == (n mod 2 == 1)
    example odd(3)
    example odd(0) == false
    match n mod 2:
      0 -> yield false
      _ -> yield true

  # Euclidean quotient and remainder together (DEC-LLL-026). `requires b > 0` makes
  # the pair UNIQUE (`0 <= r < b`), so the reconstruction `a == b*q + r` holds and the
  # `example` clauses pin exact values — including for a negative dividend.
  part divmod(a: Int, b: Int) -> (Int, Int):
    requires b > 0
    ensures a == b * result.0 + result.1
    ensures result.1 >= 0 and result.1 < b
    example divmod(17, 5).0 == 3
    example divmod(17, 5).1 == 2
    example divmod(0 - 17, 5).0 == 0 - 4
    example divmod(0 - 17, 5).1 == 3
    yield (a div b, a mod b)
