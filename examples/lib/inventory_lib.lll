module InventoryLib:

  # The inventory parts as an IMPORTABLE module, without a `main`.
  #
  # Names are prefixed `stock_*` so that each symbol carries an unambiguous identity across the
  # import boundary. The no-oversell invariant travels with the contracts: a consumer discharges
  # its own obligations from them without reopening any body here.


  # Available is on-hand less committed, proved non-negative.
  part stock_available(on_hand: Int, committed: Int) -> Int:
    requires 0 <= committed
    requires committed <= on_hand
    ensures result >= 0
    ensures result == on_hand - committed
    yield on_hand - committed

  # Reserving is legal only up to what is available, and the `ensures` re-establishes the invariant
  # so a consumer discharges its own bound from this one.
  part stock_reserve(on_hand: Int, committed: Int, qty: Int) -> Int:
    requires 0 <= committed
    requires committed <= on_hand
    requires 0 <= qty
    requires qty <= on_hand - committed
    ensures committed <= result
    ensures result <= on_hand
    yield committed + qty
