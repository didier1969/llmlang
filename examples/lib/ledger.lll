module LedgerLib:

  # The ledger parts as an IMPORTABLE module: the same verified parts as
  # `examples/verified_ledger.lll`, without a `main`.
  #
  # A consumer writes `import "lib/ledger.lll"` and calls these directly. The imported module's
  # proof stands on its own — the consumer relies on the contracts without re-proving anything.


  # The computed total equals the exact sum of the entries, for any number of them.
  part ledger_total(entries: List[Int]) -> Int:
    ensures result == sum(entries)
    measure length(entries)
    match entries:
      [] -> yield 0
      e :: rest -> yield e + ledger_total(rest)

  # Splitting the first entry into two parts that recompose it leaves the total unchanged.
  part split_first(entries: List[Int], k: Int) -> List[Int]:
    ensures sum(result) == sum(entries)
    match entries:
      [] -> yield []
      e :: rest -> yield k :: (e - k) :: rest
