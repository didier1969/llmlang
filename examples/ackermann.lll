module Ackermann:

  # The canonical case for a LEXICOGRAPHIC measure.
  #
  # Ackermann's function decreases on no single argument: in `ack(m-1, ack(m, n-1))` the inner
  # call leaves `m` unchanged. What decreases is the TUPLE `(m, n)` compared lexicographically,
  # which is what `measure m, n` says — no hand-rolled arithmetic encoding such as `m*K + n`.
  #
  #   ack(m - 1, …)   m decreases, so the order ignores n
  #   ack(m, n - 1)   m is equal, n decreases
  #   ack(m - 1, 1)   m decreases
  #
  # `ensures result >= 0` is required rather than decorative. The inner call's result is
  # havocked at the outer call site, so without that contract neither the precondition nor the
  # measure's own non-negativity would hold. Modular verification imports the callee's contract
  # to discharge the obligation, and the contract is true — `ack` always returns at least 1.


  part ack(m: Int, n: Int) -> Int:
    requires m >= 0 and n >= 0
    ensures result >= 0
    measure m, n
    match m:
      0 -> yield n + 1
      _ ->
        match n:
          0 -> yield ack(m - 1, 1)
          _ -> yield ack(m - 1, ack(m, n - 1))

  # Runtime check against the closed forms: ack(2, n) is 2n + 3, so ack(2, 2) is 7;
  # ack(3, n) is 2^(n+3) - 3, so ack(3, 3) is 61.
  part main() -> Int via IO:
    let a = IO.print(ack(2, 2))
    yield IO.print(ack(3, 3))
