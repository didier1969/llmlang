module SolverLp:

  # The modelling surface for an external solver.
  #
  # `solve` returns a solution of variable length for N variables, and the model is a NEUTRAL
  # form the solver does not dictate: N integer variables, M linear constraints of the shape
  # `sum(c_i * x_i)` against a bound, and one linear objective, all flattened into a `List[Int]`.
  # Different solvers are adapters over that same form.
  #
  # The result of `solve` is HAVOCKED, so the verified core can prove nothing about it. To
  # discharge `use_solution`'s precondition the program MUST call a verified witness check —
  # the verification discipline forces the re-check rather than trusting the oracle, and a
  # solution violating any constraint is rejected.


  effect Solver:
    solve(List[Int]) -> List[Int] = extern "lll_solver_runtime::solve"

  # Reify the havocked solution as an array so contracts can index it. The array stays opaque
  # to the prover, so the conversion does not weaken the havoc wall.
  part to_array(xs: List[Int], acc: Array[Int]) -> Array[Int]:
    match xs:
      []     -> yield acc
      h :: t -> yield to_array(t, push(acc, h))

  # The witness check, at N = 3. Two families and one aggregate:
  # Indices are in bounds by the `requires length == 3`.
  #   non-negativity   get(sol, i) >= 0 for each i
  #   ceiling          get(sol, i) <= 6 for each i
  #   capacity         the three together are at most 10
  #
  # On the `true` branch below, the contract firewall assumes this `ensures`, and that
  # conjunction is what discharges `use_solution`'s precondition.
  part feasible(sol: Array[Int]) -> Bool:
    requires length(sol) == 3
    ensures result == (get(sol, 0) >= 0 and get(sol, 1) >= 0 and get(sol, 2) >= 0 and get(sol, 0) <= 6 and get(sol, 1) <= 6 and get(sol, 2) <= 6 and get(sol, 0) + get(sol, 1) + get(sol, 2) <= 10)
    yield get(sol, 0) >= 0 and get(sol, 1) >= 0 and get(sol, 2) >= 0 and get(sol, 0) <= 6 and get(sol, 1) <= 6 and get(sol, 2) <= 6 and get(sol, 0) + get(sol, 1) + get(sol, 2) <= 10

  # Consumes the checked solution. Its precondition can only be discharged through the witness,
  # since `sol` came from the oracle.
  part use_solution(sol: Array[Int]) -> Int:
    requires length(sol) == 3
    requires get(sol, 0) >= 0 and get(sol, 1) >= 0 and get(sol, 2) >= 0
    requires get(sol, 0) <= 6 and get(sol, 1) <= 6 and get(sol, 2) <= 6
    requires get(sol, 0) + get(sol, 1) + get(sol, 2) <= 10
    ensures result >= 0
    yield get(sol, 0) * 3 + get(sol, 1) * 2 + get(sol, 2)

  part main() -> Int via Solver, IO:
    # Maximise 3x + 2y + z subject to 0 <= each <= 6 and x + y + z <= 10, giving (6, 4, 0).
    # Flat encoding: [nvars, ncons, sense, objective.., then per constraint: rel, rhs, coeffs..]
    #   sense: 0 = minimise, 1 = maximise      rel: 0 = `<=`, 1 = `>=`, 2 = `==`
    let model = [3, 7, 1, 3, 2, 1, 1, 0, 1, 0, 0, 1, 0, 0, 1, 0, 1, 0, 0, 0, 1, 0, 6, 1, 0, 0, 0, 6, 0, 1, 0, 0, 6, 0, 0, 1, 0, 10, 1, 1, 1]
    let sol = to_array(Solver.solve(model), array())
    # Length is re-checked at runtime: an oracle returning the wrong number of variables, or
    # nothing when it fails, takes the `false` branch.
    match length(sol) == 3:
      true ->
        match feasible(sol):
          true  -> yield IO.print(use_solution(sol))   # 3*6 + 2*4 + 0 = 26
          false -> yield IO.print(0 - 1)                # infeasible solution, rejected
      false -> yield IO.print(0 - 2)                    # wrong number of variables, rejected
