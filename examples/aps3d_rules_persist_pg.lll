import "../std/db_pg.lll"
import "aps3d_maintenance_kernel.lll"

module Aps3d.Persist:

  # The PostgreSQL twin of `aps3d_rules_persist.lll`.
  #
  # Exactly one line differs — the backend import — plus the argument to `Db.open`, which is
  # backend-specific configuration. There is no `depends` line at all: the dependency follows
  # the import transitively. The proved domain kernel and the whole typed reconstruction are
  # identical, because the contract is.
  #
  # Schema: rules(kind, threshold, horizon), where kind 0 is WearAbove and 1 is DaysBelow.


  part flag(b: Bool) -> Int:
    match b:
      true  -> yield 1
      false -> yield 0

  # kind 0 is WearAbove, anything else DaysBelow.
  part mk_cond(kind: Int, t: Int) -> Condition:
    match kind == 0:
      true  -> yield WearAbove(t)
      false -> yield DaysBelow(t)

  # one row becomes one typed single-condition rule.
  part row_to_rule(row: Json) -> Rule:
    yield Rule(mk_cond(cell_int(row, 0), cell_int(row, 1)) :: [], Schedule(cell_int(row, 2)))

  # rebuild the typed rules from the rows.
  part rows_to_rules(rows: List[Json]) -> List[Rule]:
    match rows:
      []     -> yield []
      h :: t -> yield row_to_rule(h) :: rows_to_rules(t)

  part main() -> Int via IO, Db:
    let db = Db.open("host=127.0.0.1 port=5442 user=aps3d dbname=aps3d_rules")
    let sd = Db.exec(db, "DROP TABLE IF EXISTS rules")
    let s0 = Db.exec(db, "CREATE TABLE rules (kind INTEGER, threshold INTEGER, horizon INTEGER)")
    let s1 = Db.exec(db, "INSERT INTO rules VALUES (0, 90, 3)")
    let s2 = Db.exec(db, "INSERT INTO rules VALUES (0, 75, 14)")
    let s3 = Db.exec(db, "INSERT INTO rules VALUES (1, 7, 1)")
    let rows = unarr(Db.query(db, "SELECT kind, threshold, horizon FROM rules ORDER BY threshold"))
    let rules = rows_to_rules(rows)
    let facts = Facts(95, 20)
    # Two rules match the reloaded equipment: 95 exceeds both 90 and 75, while 20 is not below 7.
    let a = IO.print(flag(len(evaluate(rules, facts)) == 2))
    # Exactly the three inserted rules came back.
    let b = IO.print(flag(count(rows) == 3))
    # Severity, proved to lie in [0, 3], is 3 here.
    yield IO.print(flag(severity(facts) == 3))
