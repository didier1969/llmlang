module ErpOrderToCashVerified:

  # Order to cash: three invariants proved to hold TOGETHER on one result.
  #
  # Separate guarantees are only worth something if they compose without one breaking another.
  # Fulfilling an order here has to satisfy all three at once:
  #
  #   capacity   the stock is not oversold
  #   ordering   the invoice number is the immediate successor, leaving no gap
  #   floor      the net price never falls below cost
  #
  # Each part's precondition is discharged by the flow's own preconditions, and the three
  # `ensures` compose into `fulfill`'s contract.


  type Order = {committed: Int, invoice: Int, net: Int}

  # Capacity: reserve without overselling.
  part reserve(on_hand: Int, committed: Int, qty: Int) -> Int:
    requires 0 <= committed
    requires committed <= on_hand
    requires 0 <= qty
    requires qty <= on_hand - committed
    ensures result == committed + qty
    ensures result <= on_hand
    yield committed + qty

  # Ordering: the next invoice number, with no gap.
  part next_invoice(last: Int) -> Int:
    requires last >= 0
    ensures result == last + 1
    yield last + 1

  # Floor: a discount can never take the net price below cost.
  part net_price(price: Int, cost: Int, discount: Int) -> Int:
    requires 0 <= cost
    requires cost <= price
    requires 0 <= discount
    requires discount <= price - cost
    ensures result == price - discount
    ensures result >= cost
    yield price - discount

  # The composite: reserve, number, price — and prove all three invariants of the result.
  part fulfill(on_hand: Int, committed: Int, qty: Int, last: Int, price: Int, cost: Int, discount: Int) -> Order:
    requires 0 <= committed
    requires committed <= on_hand
    requires 0 <= qty
    requires qty <= on_hand - committed
    requires last >= 0
    requires 0 <= cost
    requires cost <= price
    requires 0 <= discount
    requires discount <= price - cost
    ensures result.committed <= on_hand      # stock is not oversold
    ensures result.invoice == last + 1        # invoice numbering leaves no gap
    ensures result.net >= cost                # never sold below cost
    yield Order(reserve(on_hand, committed, qty), next_invoice(last), net_price(price, cost, discount))

  part main() -> Int via IO:
    # 100 on hand, 30 committed, ordering 40; last invoice 5000; price 200, cost 120, discount 50.
    # Gives committed 70, invoice 5001, net 150 — all three guarantees at once.
    let o = fulfill(100, 30, 40, 5000, 200, 120, 50)
    let a = IO.print(o.committed)
    let b = IO.print(o.invoice)
    yield IO.print(o.net)
