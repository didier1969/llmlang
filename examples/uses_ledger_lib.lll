# Cross-module reuse of a verified library module.
#
# The imported module's proof stands; this consumer builds on its contracts without re-proving
# them, and without ever seeing a body.

import "lib/ledger.lll"

module UsesLedgerLib:

  # A report built on the library: the total, then the total after reallocating one line. They
  # are proved equal, so the conservation guarantee crosses the import.
  part report(entries: List[Int]) -> Int:
    ensures result == sum(entries)
    yield ledger_total(entries)

  part main() -> Int via IO:
    # 100 + 250 - 50 + 300 = 600, computed by the imported module.
    yield IO.print(report([100, 250, -50, 300]))
