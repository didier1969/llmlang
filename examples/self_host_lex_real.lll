module SelfHost.LexReal:

  # A lexer for llmlang's own concrete syntax, written in llmlang.
  #
  # Not a toy language: it handles the real keywords, identifiers over letters and `_`,
  # integers, and above all the MULTI-CHARACTER operators `->` `::` `>=` `<=` `==` `!=`, which
  # is where a one-character-at-a-time lexer breaks. A string is a `List[Int]` of codepoints.
  #
  # `lexA` stays SELF-recursive. Its one-character lookahead is delegated to non-recursive
  # helpers rather than to a mutually recursive partner, which would reopen the measure over
  # the whole group. Termination is `measure length(s)`: the recursive calls are on the tail,
  # or the tail of the tail for a two-character operator.


  type LTok = KPart | KRequires | KEnsures | KMeasure | KYield | TId(List[Int]) | TInt(Int) | TLParen | TRParen | TComma | TColon | TArrow | TColonColon | TGe | TLe | TEqEq | TNe | TLt | TGt | TAssign | TPlus | TMinus | TStar | TSlash

  type Pend = NoPend | PNum(Int) | PId(List[Int])

  # ---- character classes ----
  part isDigit(c: Int) -> Bool:
    yield c >= 48 and c <= 57

  # an identifier character: a letter or `_`
  part isAlpha(c: Int) -> Bool:
    yield (c >= 97 and c <= 122) or (c >= 65 and c <= 90) or c == 95

  part snoc(xs: List[Int], c: Int) -> List[Int]:
    match xs:
      []     -> yield c :: []
      h :: t -> yield h :: snoc(t, c)

  part eqStr(a: List[Int], b: List[Int]) -> Bool:
    match a:
      []       ->
        match b:
          [] -> yield true
          _  -> yield false
      ha :: ta ->
        match b:
          []       -> yield false
          hb :: tb ->
            match ha == hb:
              true  -> yield eqStr(ta, tb)
              false -> yield false

  # an identifier run becomes a keyword token or a TId.
  part classify(chars: List[Int]) -> LTok:
    match eqStr(chars, "part"):
      true  -> yield KPart
      false ->
        match eqStr(chars, "requires"):
          true  -> yield KRequires
          false ->
            match eqStr(chars, "ensures"):
              true  -> yield KEnsures
              false ->
                match eqStr(chars, "measure"):
                  true  -> yield KMeasure
                  false ->
                    match eqStr(chars, "yield"):
                      true  -> yield KYield
                      false -> yield TId(chars)

  # ---- delimiters: one-character lookahead, all non-recursive ----
  # does the pair (c, d) form a two-character operator?
  # `::`(58,58) `->`(45,62) `>=`(62,61) `<=`(60,61) `==`(61,61) `!=`(33,61)
  part isTwo(c: Int, d: Int) -> Bool:
    yield (c == 58 and d == 58) or (c == 45 and d == 62) or (c == 62 and d == 61) or (c == 60 and d == 61) or (c == 61 and d == 61) or (c == 33 and d == 61)

  part two(c: Int, d: Int) -> LTok:
    match c == 58:
      true  -> yield TColonColon
      false ->
        match c == 45:
          true  -> yield TArrow
          false ->
            match c == 62:
              true  -> yield TGe
              false ->
                match c == 60:
                  true  -> yield TLe
                  false ->
                    match c == 61:
                      true  -> yield TEqEq
                      false -> yield TNe                 # (33,61) is !=

  # prefix the one-character token for `c`; spaces and unknown characters are skipped.
  part delim1cons(c: Int, rest: List[LTok]) -> List[LTok]:
    match c == 40:
      true  -> yield TLParen :: rest
      false ->
        match c == 41:
          true  -> yield TRParen :: rest
          false ->
            match c == 44:
              true  -> yield TComma :: rest
              false ->
                match c == 58:
                  true  -> yield TColon :: rest
                  false ->
                    match c == 45:
                      true  -> yield TMinus :: rest
                      false ->
                        match c == 62:
                          true  -> yield TGt :: rest
                          false ->
                            match c == 60:
                              true  -> yield TLt :: rest
                              false ->
                                match c == 61:
                                  true  -> yield TAssign :: rest
                                  false ->
                                    match c == 43:
                                      true  -> yield TPlus :: rest
                                      false ->
                                        match c == 42:
                                          true  -> yield TStar :: rest
                                          false ->
                                            match c == 47:
                                              true  -> yield TSlash :: rest
                                              false -> yield rest      # space (32) or unknown

  # flush the accumulator ahead of `rest`; it holds zero or one pending token.
  part consPend(p: Pend, rest: List[LTok]) -> List[LTok]:
    match p:
      NoPend  -> yield rest
      PNum(n) -> yield TInt(n) :: rest
      PId(cs) -> yield classify(cs) :: rest

  part flushEnd(p: Pend) -> List[LTok]:
    match p:
      NoPend  -> yield []
      PNum(n) -> yield TInt(n) :: []
      PId(cs) -> yield classify(cs) :: []

  # ---- the lexer: a three-state accumulator, self-recursive ----
  part lexA(s: List[Int], p: Pend) -> List[LTok]:
    measure length(s)
    match s:
      []     -> yield flushEnd(p)
      c :: t ->
        match isDigit(c):
          true  ->                          # digit: extend or start a number
            match p:
              NoPend  -> yield lexA(t, PNum(c - 48))
              PNum(n) -> yield lexA(t, PNum(n * 10 + (c - 48)))
              PId(cs) -> yield classify(cs) :: lexA(t, PNum(c - 48))
          false ->
            match isAlpha(c):
              true  ->                      # letter or '_': extend or start an identifier
                match p:
                  NoPend  -> yield lexA(t, PId(c :: []))
                  PId(cs) -> yield lexA(t, PId(snoc(cs, c)))
                  PNum(n) -> yield TInt(n) :: lexA(t, PId(c :: []))
              false ->                      # delimiter: flush, then dispatch
                match t:
                  [] -> yield consPend(p, delim1cons(c, []))
                  d :: t2 ->
                    match isTwo(c, d):
                      true  -> yield consPend(p, two(c, d) :: lexA(t2, NoPend))
                      false -> yield consPend(p, delim1cons(c, lexA(t, NoPend)))

  part lex(s: List[Int]) -> List[LTok]:
    yield lexA(s, NoPend)

  # ---- runtime check: a per-kind weighted signature over the token stream ----
  # Splitting `->`, splitting `>=`, or lexing `part` as an identifier each change a count, and
  # therefore the signature.
  part w(t: LTok) -> Int:
    match t:
      KPart       -> yield 1
      KRequires   -> yield 2
      KEnsures    -> yield 3
      KMeasure    -> yield 4
      KYield      -> yield 5
      TId(cs)     -> yield 6
      TInt(n)     -> yield 7
      TLParen     -> yield 8
      TRParen     -> yield 9
      TComma      -> yield 10
      TColon      -> yield 11
      TArrow      -> yield 12
      TColonColon -> yield 13
      TGe         -> yield 14
      TLe         -> yield 15
      TEqEq       -> yield 16
      TNe         -> yield 17
      TLt         -> yield 18
      TGt         -> yield 19
      TAssign     -> yield 20
      TPlus       -> yield 21
      TMinus      -> yield 22
      TStar       -> yield 23
      TSlash      -> yield 24

  part sig(toks: List[LTok]) -> Int:
    match toks:
      []     -> yield 0
      h :: t -> yield w(h) + sig(t)

  part main() -> Int via IO:
    # A real part signature: 13 tokens, with `->` as one TArrow and `part` as a keyword.
    let a = IO.print(sig(lex("part gcd(a: Int, b: Int) -> Int")))   # 98
    # Every multi-character operator, plus the single-character ones.
    let b = IO.print(sig(lex("x :: y == z != w <= v + a * b / c < d > e")))  # 226
    # A real contract clause, with `>=` as one token.
    yield IO.print(sig(lex("requires a >= 0")))                     # 29
