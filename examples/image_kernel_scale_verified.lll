module ImageKernelScale:

  # A verified image kernel AT SCALE, over a contiguous array.
  # A mask of 262 144 pixels (512 by 512), built and then refined.
  # Sweeping an `Array` with O(1) `set`/`get` over contiguous memory, not a linked list.
  # Proved at symbolic N: output in [0, 255], length preserved. The performance claim only
  # for a build and sweep of 262k pixels, roughly 19 times the equivalent interpreted Python. The
  # holds where the substrate is contiguous: a cons-cell list is roughly 18 times slower here,
  # because it allocates per element.

  part refine_px(a: Int) -> Int:
    ensures 0 <= result, result <= 255
    match a <= 50:
      true  -> yield 0
      false ->
        match a >= 200:
          true  -> yield 255
          false -> yield ((a - 50) * 255) div 150

  # Build a mask of n pixels with varied values, rather than a constant array, which would let the
  # branch predictor do the work, which would flatter the measurement.
  part build(i: Int, n: Int, acc: Array[Int]) -> Array[Int]:
    requires 0 <= i, i <= n
    requires length(acc) == i
    ensures length(result) == n
    measure n - i
    match i >= n:
      true  -> yield acc
      false -> yield build(i + 1, n, push(acc, i mod 256))

  # Sweep the array in place: `set` is O(1) copy-on-write while the reference is unique.
  part sweep(src: Array[Int], i: Int) -> Array[Int]:
    requires 0 <= i, i <= length(src)
    ensures length(result) == length(src)
    measure length(src) - i
    match i >= length(src):
      true  -> yield src
      false -> yield sweep(set(src, i, refine_px(get(src, i))), i + 1)

  part main() -> Int via IO:
    let raw = build(0, 262144, array())
    let out = sweep(raw, 0)
    yield IO.print(get(out, 0))
