module VerifiedBoundedSum:

  # A property of every ELEMENT propagating to the AGGREGATE.
  #
  # Given that all entries are non-negative, the total is too — proved for any number of lines
  # rather than checked on a few data sets. The induction is over the list: at `e :: rest` the
  # head predicate gives `e >= 0`, the `forall` carries to the tail so the recursive call's
  # precondition holds, and the hypothesis gives the tail's total.


  part total(entries: List[Int]) -> Int:
    requires forall e in entries: e >= 0
    ensures result == sum(entries)
    ensures result >= 0
    measure length(entries)
    match entries:
      [] -> yield 0
      e :: rest -> yield e + total(rest)

  part main() -> Int via IO:
    # 100 + 250 + 300 = 650, with every entry non-negative.
    yield IO.print(total([100, 250, 300]))
