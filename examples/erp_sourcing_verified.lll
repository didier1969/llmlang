module ErpSourcingVerified:

  # Minimum-cost sourcing whose feasibility is proved, not assumed.
  #
  # A solver picks the cheapest purchase plan across three suppliers. It is an ORACLE at the
  # effect boundary: its result is havocked, so the verified core knows nothing about what it
  # returned. `feasible` then re-establishes every constraint from scratch — non-negativity,
  # per-supplier capacity, demand coverage, and cost within budget — and a plan failing any
  # one of them is rejected rather than repaired. The margin `budget - cost` is proved >= 0
  # for whatever the solver hands back, including a wrong or hostile answer.
  #
  # THE TRAP, if you edit this. The budget ceiling also appears in the model table passed to
  # the solver, and that occurrence proves NOTHING — the result is havocked, so the prover
  # never sees the model. What discharges the margin's `requires` is the `cost <= budget`
  # conjunct in the `ensures` of `feasible`. Remove it from the model and the proof still
  # holds; remove it from `feasible` and the proof is gone, while the program still looks
  # like it checks the budget.
  #
  # The problem: 60 units of one material across three suppliers, in cents per unit.
  #
  #   supplier A (sol[0])    8 c/u   capacity 40
  #   supplier B (sol[1])    5 c/u   capacity 30      cheapest
  #   supplier C (sol[2])   11 c/u   capacity 50
  #
  # Minimise the total cost subject to demand >= 60 and cost <= 700. The exact integer
  # optimum buys cheapest-first: B=30 saturated, A=30, for 390 c and a margin of 310 c.

  effect Solver:
    solve(List[Int]) -> List[Int] = extern "lll_solver_runtime::solve"

  # Reify the plan as an array so contracts can index it and use `length`. The array stays
  # opaque to the prover: no feasibility fact crosses this bridge, so the conversion does not
  # weaken the havoc wall.
  part to_array(xs: List[Int], acc: Array[Int]) -> Array[Int]:
    match xs:
      []     -> yield acc
      h :: t -> yield to_array(t, push(acc, h))

  # The witness check. Indices are supplier A, B, C in order. On the `true` branch of the
  # match below, the contract firewall assumes this `ensures`, and that conjunction is what
  # discharges `procurement_cost`'s preconditions — the solver's own model discharges nothing.
  part feasible(sol: Array[Int]) -> Bool:
    requires length(sol) == 3
    ensures result == (get(sol, 0) >= 0 and get(sol, 1) >= 0 and get(sol, 2) >= 0 and get(sol, 0) <= 40 and get(sol, 1) <= 30 and get(sol, 2) <= 50 and get(sol, 0) + get(sol, 1) + get(sol, 2) >= 60 and get(sol, 0) * 8 + get(sol, 1) * 5 + get(sol, 2) * 11 <= 700)
    yield get(sol, 0) >= 0 and get(sol, 1) >= 0 and get(sol, 2) >= 0 and get(sol, 0) <= 40 and get(sol, 1) <= 30 and get(sol, 2) <= 50 and get(sol, 0) + get(sol, 1) + get(sol, 2) >= 60 and get(sol, 0) * 8 + get(sol, 1) * 5 + get(sol, 2) * 11 <= 700

  # Total purchase cost in cents. Because `sol` comes from the havocked oracle, these
  # preconditions can only ever be discharged through the witness check — there is no other
  # source of knowledge about it in scope.
  part procurement_cost(sol: Array[Int]) -> Int:
    requires length(sol) == 3
    requires get(sol, 0) >= 0 and get(sol, 1) >= 0 and get(sol, 2) >= 0
    requires get(sol, 0) * 8 + get(sol, 1) * 5 + get(sol, 2) * 11 <= 700
    ensures result >= 0
    ensures result <= 700
    yield get(sol, 0) * 8 + get(sol, 1) * 5 + get(sol, 2) * 11

  # Proved non-negative without the prover ever reopening `procurement_cost`'s body — only
  # its `ensures` is in scope here. That is what makes the proof modular: changing how the
  # cost is computed cannot break this, as long as the contract still holds.
  part margin(revenue: Int, cost: Int) -> Int:
    requires revenue >= cost
    requires cost >= 0
    ensures result >= 0
    yield revenue - cost

  part main() -> Int via Solver, IO:
    # Solver-agnostic flat encoding, laid out as:
    #   [nvars, ncons, sense, objective coefficients.., then per constraint: rel, rhs, coeffs..]
    #   sense: 0 = minimise, 1 = maximise      rel: 0 = `<=`, 1 = `>=`, 2 = `==`
    # Here: 3 variables and 8 constraints — three non-negativities, three capacities, one
    # demand, one budget.
    let model = [3, 8, 0, 8, 5, 11, 1, 0, 1, 0, 0, 1, 0, 0, 1, 0, 1, 0, 0, 0, 1, 0, 40, 1, 0, 0, 0, 30, 0, 1, 0, 0, 50, 0, 0, 1, 1, 60, 1, 1, 1, 0, 700, 8, 5, 11]
    let sol = to_array(Solver.solve(model), array())
    # Length is re-checked at runtime: an oracle that returns the wrong number of suppliers,
    # or nothing at all when the problem is infeasible, takes the `false` branch and never
    # reaches the cost computation.
    match length(sol) == 3:
      true ->
        match feasible(sol):
          true  ->
            let cost = procurement_cost(sol)   # optimum: 390 cents
            yield IO.print(margin(700, cost))  # margin: 700 - 390 = 310 cents
          false -> yield IO.print(0 - 1)       # infeasible plan, rejected
      false -> yield IO.print(0 - 2)           # wrong number of suppliers, rejected
