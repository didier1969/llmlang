module SelfHost.Codegen:

  # The back end of the small `Expr` language: a code generator targeting a stack machine, plus
  # the VM that runs the bytecode, both written in llmlang.
  #
  # Semantic preservation — running the compiled form gives what evaluating the tree gives —
  # cannot be stated as a contract, since a contract may not call a part, so it is demonstrated
  # at runtime instead.


  type Expr  = Lit(Int) | Neg(Expr) | Add(Expr, Expr) | Sub(Expr, Expr) | Mul(Expr, Expr)
  type Instr = Push(Int) | INeg | IAdd | ISub | IMul

  # ---- reference evaluator ----
  part eval(e: Expr) -> Int:
    match e:
      Lit(n)    -> yield n
      Neg(a)    -> yield 0 - eval(a)
      Add(a, b) -> yield eval(a) + eval(b)
      Sub(a, b) -> yield eval(a) - eval(b)
      Mul(a, b) -> yield eval(a) * eval(b)

  # ---- code generation: an expression to a bytecode program, in post-order ----
  part iappend(xs: List[Instr], ys: List[Instr]) -> List[Instr]:
    match xs:
      []     -> yield ys
      h :: t -> yield h :: iappend(t, ys)

  # compile the subtrees first, then the operation.
  part compile(e: Expr) -> List[Instr]:
    match e:
      Lit(n)    -> yield Push(n) :: []
      Neg(a)    -> yield iappend(compile(a), INeg :: [])
      Add(a, b) -> yield iappend(compile(a), iappend(compile(b), IAdd :: []))
      Sub(a, b) -> yield iappend(compile(a), iappend(compile(b), ISub :: []))
      Mul(a, b) -> yield iappend(compile(a), iappend(compile(b), IMul :: []))

  # ---- the stack VM ----
  # The stack is a `List[Int]` with the top at the head. For a binary operation the right
  # operand was pushed last, so it sits on top and the left operand is directly beneath it.
  part run(prog: List[Instr], st: List[Int]) -> Int:
    match prog:
      []        ->
        match st:
          []        -> yield 0
          v :: srest -> yield v                 # the top of the stack is the result
      i :: rest ->
        match i:
          Push(n) -> yield run(rest, n :: st)
          INeg    ->
            match st:
              a :: s2 -> yield run(rest, (0 - a) :: s2)
              _       -> yield 0
          IAdd    ->
            match st:
              b :: s1 ->
                match s1:
                  a :: s2 -> yield run(rest, (a + b) :: s2)
                  _       -> yield 0
              _ -> yield 0
          ISub    ->
            match st:
              b :: s1 ->
                match s1:
                  a :: s2 -> yield run(rest, (a - b) :: s2)
                  _       -> yield 0
              _ -> yield 0
          IMul    ->
            match st:
              b :: s1 ->
                match s1:
                  a :: s2 -> yield run(rest, (a * b) :: s2)
                  _       -> yield 0
              _ -> yield 0

  # ---- runtime check: the back end preserves what the evaluator computes ----
  part main() -> Int via IO:
    let e = Add(Mul(Lit(3), Lit(4)), Neg(Lit(5)))   # (3*4) + (-5) is 7
    let delta = run(compile(e), []) - eval(e)       # 0 means the back end agrees
    let d = IO.print(delta)                          # 0
    yield IO.print(run(compile(e), []))              # 7
