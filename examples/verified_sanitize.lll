module VerifiedSanitize:

  # A guarantee established once by a producer, and consumed downstream for free.
  #
  # `keep_positive` proves that every element of its RESULT is positive. `safe_total` then
  # discharges `sum_positive`'s `requires` from that fact alone — no re-test at the boundary,
  # no runtime check, and no consumer that forgets to look.
  #
  # The usual shape is to filter and then re-test `amount > 0` in every consumer, or to forget
  # to. Here the guarantee travels with the value across the function boundary.


  # Produces a list whose elements are all positive: on the branch that keeps `h` the guard
  # gives `h > 0`, and the recursive call carries the same guarantee for the rest.
  part keep_positive(xs: List[Int]) -> List[Int]:
    ensures forall y in result: y > 0
    measure length(xs)
    match xs:
      [] -> yield []
      h :: t -> yield if h > 0 then h :: keep_positive(t) else keep_positive(t)

  # Consumes the guarantee: given all-positive elements, the total is non-negative.
  part sum_positive(ys: List[Int]) -> Int:
    requires forall y in ys: y > 0
    ensures result >= 0
    measure length(ys)
    match ys:
      [] -> yield 0
      h :: t -> yield h + sum_positive(t)

  # The bridge: the producer's `ensures` is exactly the consumer's `requires`, so composing
  # them costs nothing at runtime.
  part safe_total(xs: List[Int]) -> Int:
    ensures result >= 0
    let clean = keep_positive(xs)
    yield sum_positive(clean)

  part main() -> Int via IO:
    # [5, -3, 10, -1, 8] filters to [5, 10, 8], totalling 23.
    yield IO.print(safe_total([5, -3, 10, -1, 8]))
