module VerifiedRegistry:

  # Referential integrity over a master-data registry.
  #
  # Three properties are proved rather than tested: a key that was written is present; two
  # writes to distinct keys coexist, which is the one a naive implementation most often breaks;
  # and reading back a key just written returns exactly its value, with no silent default.


  # After a write the key is present — nothing is silently lost.
  part register(catalog: Map[Int, Int], item: Int, price: Int) -> Map[Int, Int]:
    ensures haskey(result, item)
    yield insert(catalog, item, price)

  # Writes to distinct keys coexist: inserting one does not evict the other.
  part register2(catalog: Map[Int, Int], a: Int, b: Int, pa: Int, pb: Int) -> Map[Int, Int]:
    requires a != b
    ensures haskey(result, a)
    ensures haskey(result, b)
    yield insert(insert(catalog, a, pa), b, pb)

  # Reading back a key just written returns exactly what was written.
  part price_after_register(catalog: Map[Int, Int], item: Int, price: Int) -> Int:
    ensures result == price
    let m = insert(catalog, item, price)
    yield lookup(m, item)

  part main() -> Int via IO:
    # Write item 42 at 1500, then write item 7 at 999 and read it back.
    let cat = register(map(), 42, 1500)
    yield IO.print(price_after_register(cat, 7, 999))
