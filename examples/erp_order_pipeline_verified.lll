module ErpOrderPipeline:

  # An order's money path, proved end to end.
  #
  # Everything is exact integers: amounts in cents, rates in basis points where 10000 bps is
  # 100%. No floating point means no silent rounding, and the invariants below hold for every
  # valid input rather than for the cases someone thought to test.
  #
  # What the file demonstrates beyond any single function is the CALL GRAPH: `invoice` calls
  # `with_tax` and `order_subtotal`, which calls `line_net`; `installments` calls `share`.
  # Each level proves its own invariant using only the CONTRACTS of the level below, never its
  # body. That is what makes the proofs modular: changing how `line_net` computes a discount
  # cannot break `invoice`, while changing its contract will.

  # A line's net: gross (quantity times unit price) less the discount. The contract pins it
  # inside [0, gross] — money never goes negative, and a discount can only ever lower it.
  part line_net(qty: Int, unit_price: Int, disc_bps: Int) -> Int:
    requires qty >= 0
    requires unit_price >= 0
    requires disc_bps >= 0
    requires disc_bps <= 10000
    ensures result >= 0
    ensures result <= qty * unit_price
    let gross = qty * unit_price
    yield gross - (gross * disc_bps div 10000)

  # Non-negativity here is proved from `line_net`'s own `ensures`, twice over. The prover
  # never looks inside `line_net`.
  part order_subtotal(q1: Int, p1: Int, d1: Int, q2: Int, p2: Int, d2: Int) -> Int:
    requires q1 >= 0
    requires p1 >= 0
    requires d1 >= 0
    requires d1 <= 10000
    requires q2 >= 0
    requires p2 >= 0
    requires d2 >= 0
    requires d2 <= 10000
    ensures result >= 0
    yield line_net(q1, p1, d1) + line_net(q2, p2, d2)

  # Tax never decreases the amount. A sign error here is a compile error, not a discrepancy
  # someone notices at year end.
  part with_tax(subtotal: Int, tax_bps: Int) -> Int:
    requires subtotal >= 0
    requires tax_bps >= 0
    ensures result >= subtotal
    yield subtotal + (subtotal * tax_bps div 10000)

  # Two hops of composition: `with_tax` gives `result >= subtotal`, `order_subtotal` gives
  # `subtotal >= 0`, so the invoice is non-negative. Neither body is reopened.
  part invoice(q1: Int, p1: Int, d1: Int, q2: Int, p2: Int, d2: Int, tax_bps: Int) -> Int:
    requires q1 >= 0
    requires p1 >= 0
    requires d1 >= 0
    requires d1 <= 10000
    requires q2 >= 0
    requires p2 >= 0
    requires d2 >= 0
    requires d2 <= 10000
    requires tax_bps >= 0
    ensures result >= 0
    yield with_tax(order_subtotal(q1, p1, d1, q2, p2, d2), tax_bps)

  # One instalment. The upper bound is not decoration: it is what discharges the recursive
  # call's precondition in `installments` below.
  part share(remaining: Int, parts_left: Int) -> Int:
    requires parts_left >= 1
    requires remaining >= 0
    ensures result >= 0
    ensures result <= remaining
    yield remaining div parts_left

  # Spread an invoice over `n` instalments without losing or inventing a cent. Each takes
  # `remaining div instalments_left`, which absorbs the remainder as it goes.
  #
  # Conservation — the instalments sum to exactly the total — is proved for SYMBOLIC `n`,
  # not checked at a few values of it. The proof needs both `share <= remaining` to justify
  # the recursion and the induction hypothesis on the shorter plan.
  part installments(total: Int, n: Int) -> Int:
    requires n >= 1
    requires total >= 0
    ensures result == total
    measure n
    yield if n == 1 then total else share(total, n) + installments(total - share(total, n), n - 1)

  part main() -> Int via IO:
    # Two lines: 3 at 12.00 with 10% off, 1 at 50.00 with none, then 20% tax.
    # 3600 - 360 = 3240, plus 5000, is a subtotal of 8240; with tax, 9888 cents.
    let inv = IO.print(invoice(3, 1200, 1000, 1, 5000, 0, 2000))   # 9888
    # Paid over 3 instalments: 3296 each, summing back to 9888 exactly.
    yield IO.print(installments(9888, 3))                           # 9888, conserved exactly
