module VerifiedInvoice:

  # Totalling an invoice, exactly.
  #
  # Two invariants that a conventional implementation leaves to hope. The comprehension mapping
  # lines to amounts is a MAP, so it preserves the count — no line is dropped or duplicated on
  # the way. And the total is proved equal to the exact sum of those amounts, in integers, so
  # the figure shown cannot drift from the true one.


  type LineItem = {qty: Int, unit_price: Int}

  # One amount per line. The comprehension is a map, so the count is preserved.
  part line_amounts(items: List[LineItem]) -> List[Int]:
    ensures length(result) == length(items)
    yield [li.qty * li.unit_price for li in items]

  # The total equals the exact sum of the line amounts, for any number of lines.
  part invoice_total(amounts: List[Int]) -> Int:
    ensures result == sum(amounts)
    measure length(amounts)
    match amounts:
      [] -> yield 0
      a :: rest -> yield a + invoice_total(rest)

  part main() -> Int via IO:
    # 2 x 500 plus 1 x 300: two lines, two amounts, a total of 1300.
    let items = [LineItem(2, 500), LineItem(1, 300)]
    yield IO.print(invoice_total(line_amounts(items)))
