import "aps3d_maintenance_kernel.lll"

module Aps3d.Maintenance:

  # The maintenance rule kernel with literal inputs and no persistence. The kernel itself is
  # imported rather than duplicated.
  #
  # Equipment worn to 95% with 20 days to failure matches both the critical-wear rule and the
  # preventive one, giving two actions; severity adds 3, for a total of 5.

  part main() -> Int:
    let rules = Rule(WearAbove(90) :: [], Alert(3)) :: Rule(WearAbove(75) :: DaysBelow(30) :: [], Schedule(14)) :: []
    yield len(evaluate(rules, Facts(95, 20))) + severity(Facts(95, 5))
