import "aps3d_maintenance_kernel.lll"

module Aps3d.Maintenance:

  # Démo PUR du noyau de règles de maintenance d'APS3D (Aps3d.Kernel) : sans
  # persistance, entrées littérales. Le noyau est importé — zéro duplication.
  #
  # E2E : équipement usé à 95 %, 20 jours avant panne. Les règles critical_wear
  # (usure>90) ET preventive (usure>75 ∧ jours<30) matchent → 2 actions ;
  # + severity({95,5}) = 3. Total attendu = 5.
  part main() -> Int:
    let rules = Rule(WearAbove(90) :: [], Alert(3)) :: Rule(WearAbove(75) :: DaysBelow(30) :: [], Schedule(14)) :: []
    yield len(evaluate(rules, Facts(95, 20))) + severity(Facts(95, 5))
