module Aps3d.Maintenance:

  # Noyau d'évaluation des règles de maintenance d'APS3D, porté en llmlang VÉRIFIÉ
  # (tracer du vertical APS3D — DEC-LLL-066). Réplique la logique PURE de
  # lib/aps3d/rules/engine.ex (condition_matches? / rule_matches? / evaluate_rules).
  # Le chargement YAML/DB et le GenServer restent en Elixir = plomberie déléguée
  # (la frontière d'effet ; ici, le domaine volatile et correctness-critique).
  #
  # Gain démontré vs l'Elixir : le fallback `condition_matches?(_, _) -> false`
  # (engine.ex:225) rend SILENCIEUSEMENT inerte une condition mal orthographiée —
  # une règle qui ne se déclenche jamais, bug invisible. Ici le match sur Condition
  # est EXHAUSTIF : une variante non traitée = erreur de compilation (DEC-LLL-015).

  # Faits agrégés d'un équipement. Les conditions `Enum.any? (wear_pct > t)` et
  # `(days_to_failure < t)` se réduisent à des comparaisons sur ces agrégats
  # ENTIERS — zéro flottant, cœur des cordes de llmlang.
  type Facts = {max_wear: Int, min_days: Int}

  # Les conditions réellement testées par le moteur (engine.ex:207-219).
  type Condition = WearAbove(Int) | DaysBelow(Int)

  # Les actions émises (engine.ex default_rules) : Alert(niveau) | Schedule(horizon).
  type Action = Alert(Int) | Schedule(Int)

  # Une règle = conjonction de conditions → une action.
  type Rule = {conds: List[Condition], act: Action}

  # Évaluation d'UNE condition. Match EXHAUSTIF : aucun fallback silencieux.
  part cond_holds(c: Condition, f: Facts) -> Bool:
    match c:
      WearAbove(t) -> yield f.max_wear > t
      DaysBelow(t) -> yield f.min_days < t

  # Conjonction : toutes les conditions tiennent. Récursion structurale (termine).
  part all_hold(cs: List[Condition], f: Facts) -> Bool:
    match cs:
      []     -> yield true
      c :: r ->
        match cond_holds(c, f):
          true  -> yield all_hold(r, f)
          false -> yield false

  # Une règle matche ssi toutes ses conditions tiennent.
  part matches(rl: Rule, f: Facts) -> Bool:
    yield all_hold(rl.conds, f)

  # Le NOYAU : les actions des règles qui matchent, dans l'ordre de priorité.
  part evaluate(rules: List[Rule], f: Facts) -> List[Action]:
    match rules:
      []      -> yield []
      rl :: r ->
        match matches(rl, f):
          true  -> yield rl.act :: evaluate(r, f)
          false -> yield evaluate(r, f)

  # Longueur d'une liste d'actions (récursion structurale).
  part len(xs: List[Action]) -> Int:
    match xs:
      []     -> yield 0
      h :: t -> yield 1 + len(t)

  # Classification de sévérité : un contrat MÉTIER prouvé. La sévérité est
  # TOUJOURS dans [0,3] quelle que soit l'entrée — une classe de bug (niveau
  # hors bornes) éliminée PAR PREUVE, pas par test (le pattern erp_records).
  part severity(f: Facts) -> Int:
    ensures result >= 0
    ensures result <= 3
    match f.min_days < 7:
      true  -> yield 3
      false ->
        match f.max_wear > 90:
          true  -> yield 3
          false ->
            match f.max_wear > 75:
              true  ->
                match f.min_days < 30:
                  true  -> yield 2
                  false -> yield 0
              false -> yield 0

  # E2E : équipement usé à 95 %, 20 jours avant panne.
  # critical_wear_alert (usure>90) ET preventive (usure>75 ∧ jours<30) matchent → 2
  # actions ; + severity({95,5}) = 3. Total attendu = 5.
  part main() -> Int:
    let rules = Rule(WearAbove(90) :: [], Alert(3)) :: Rule(WearAbove(75) :: DaysBelow(30) :: [], Schedule(14)) :: []
    yield len(evaluate(rules, Facts(95, 20))) + severity(Facts(95, 5))
