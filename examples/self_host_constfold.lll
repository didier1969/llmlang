module SelfHost.ConstFold:

  # Constant folding: a real compiler pass, written in llmlang and verified by Z3.
  #
  # The arithmetic AST mirrors the compiler's own — negation plus euclidean binary operators,
  # with the same semantics — and the pass is a total pure function over it.


  type Expr = Lit(Int) | Neg(Expr) | Add(Expr, Expr) | Sub(Expr, Expr) | Mul(Expr, Expr)

  # Reference interpreter. Structural recursion on subtrees, so termination needs no measure.
  part eval(e: Expr) -> Int:
    match e:
      Lit(n)    -> yield n
      Neg(a)    -> yield 0 - eval(a)
      Add(a, b) -> yield eval(a) + eval(b)
      Sub(a, b) -> yield eval(a) - eval(b)
      Mul(a, b) -> yield eval(a) * eval(b)

  # One folder per operation. Each binary case is split across two parts — match on `a`, then
  # on `b` through a helper — because a match scrutinises one value at a time, so there is no
  # nested tuple pattern to match both at once.
  part foldNeg(a: Expr) -> Expr:
    match a:
      Lit(x) -> yield Lit(0 - x)
      _      -> yield Neg(a)

  part foldAddL(x: Int, b: Expr) -> Expr:
    match b:
      Lit(y) -> yield Lit(x + y)
      _      -> yield Add(Lit(x), b)

  part foldAdd(a: Expr, b: Expr) -> Expr:
    match a:
      Lit(x) -> yield foldAddL(x, b)
      _      -> yield Add(a, b)

  part foldSubL(x: Int, b: Expr) -> Expr:
    match b:
      Lit(y) -> yield Lit(x - y)
      _      -> yield Sub(Lit(x), b)

  part foldSub(a: Expr, b: Expr) -> Expr:
    match a:
      Lit(x) -> yield foldSubL(x, b)
      _      -> yield Sub(a, b)

  part foldMulL(x: Int, b: Expr) -> Expr:
    match b:
      Lit(y) -> yield Lit(x * y)
      _      -> yield Mul(Lit(x), b)

  part foldMul(a: Expr, b: Expr) -> Expr:
    match a:
      Lit(x) -> yield foldMulL(x, b)
      _      -> yield Mul(a, b)

  # The pass itself, folding bottom-up.
  part fold(e: Expr) -> Expr:
    match e:
      Lit(n)    -> yield Lit(n)
      Neg(a)    -> yield foldNeg(fold(a))
      Add(a, b) -> yield foldAdd(fold(a), fold(b))
      Sub(a, b) -> yield foldSub(fold(a), fold(b))
      Mul(a, b) -> yield foldMul(fold(a), fold(b))

  # Semantic preservation cannot be stated as a contract here, since a contract may not call a
  # part. So it is demonstrated at runtime instead: folding must not change what the tree
  # evaluates to. What IS proved statically is that the pass terminates and covers every node.
  part main() -> Int via IO:
    let e = Add(Mul(Lit(3), Lit(4)), Neg(Lit(5)))   # (3*4) + (-5) is 7
    let delta = eval(fold(e)) - eval(e)             # 0 means the meaning was preserved
    let d = IO.print(delta)                         # 0
    yield IO.print(eval(fold(e)))                   # 7, the tree folded to a literal
