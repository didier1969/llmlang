module SelfHost.ConstFold:

  # Auto-hébergement étape 2 (REQ-LLL-019, DEC-LLL-024, PIL-LLL-007) : une VRAIE
  # passe de compilateur — le constant folding — écrite EN llmlang et vérifiée par
  # le vrai pipeline Z3. Dogfood : l'AST arithmétique du cœur (Neg + Bin euclidien,
  # mêmes sémantiques que opsem.rs / DEC-LLL-026) modélisé en ADT récursif, la passe
  # en fonctions pures totales. Stress-test d'expressivité pour un projet compilateur.

  type Expr = Lit(Int) | Neg(Expr) | Add(Expr, Expr) | Sub(Expr, Expr) | Mul(Expr, Expr)

  # Interpréteur de référence. Récursion structurale (sous-arbres plus petits) →
  # terminaison PROUVÉE ; le match sur les 5 constructeurs est prouvé exhaustif.
  part eval(e: Expr) -> Int:
    match e:
      Lit(n)    -> yield n
      Neg(a)    -> yield 0 - eval(a)
      Add(a, b) -> yield eval(a) + eval(b)
      Sub(a, b) -> yield eval(a) - eval(b)
      Mul(a, b) -> yield eval(a) * eval(b)

  # Replieurs par opération. Chaque binaire est décomposé en deux parts (match a,
  # puis match b via un helper) car v1 n'a pas de motif imbriqué dans un tuple —
  # on reste donc à un match single-scrutinee, arms inline.
  part foldNeg(a: Expr) -> Expr:
    match a:
      Lit(x) -> yield Lit(0 - x)
      _      -> yield Neg(a)

  part foldAddL(x: Int, b: Expr) -> Expr:
    match b:
      Lit(y) -> yield Lit(x + y)
      _      -> yield Add(Lit(x), b)

  part foldAdd(a: Expr, b: Expr) -> Expr:
    match a:
      Lit(x) -> yield foldAddL(x, b)
      _      -> yield Add(a, b)

  part foldSubL(x: Int, b: Expr) -> Expr:
    match b:
      Lit(y) -> yield Lit(x - y)
      _      -> yield Sub(Lit(x), b)

  part foldSub(a: Expr, b: Expr) -> Expr:
    match a:
      Lit(x) -> yield foldSubL(x, b)
      _      -> yield Sub(a, b)

  part foldMulL(x: Int, b: Expr) -> Expr:
    match b:
      Lit(y) -> yield Lit(x * y)
      _      -> yield Mul(Lit(x), b)

  part foldMul(a: Expr, b: Expr) -> Expr:
    match a:
      Lit(x) -> yield foldMulL(x, b)
      _      -> yield Mul(a, b)

  # La passe : constant folding bottom-up. Récursion structurale sur les sous-arbres
  # (fold(a)/fold(b)) → terminaison PROUVÉE ; exhaustivité PROUVÉE. Renvoie un Expr
  # (les params Expr sont empruntés par le modèle voie B — DEC-LLL-031).
  part fold(e: Expr) -> Expr:
    match e:
      Lit(n)    -> yield Lit(n)
      Neg(a)    -> yield foldNeg(fold(a))
      Add(a, b) -> yield foldAdd(fold(a), fold(b))
      Sub(a, b) -> yield foldSub(fold(a), fold(b))
      Mul(a, b) -> yield foldMul(fold(a), fold(b))

  # Différentiel (philosophie du projet) : la préservation sémantique n'est pas
  # exprimable en contrat (pas d'appels dans requires/ensures, DEC-LLL-017), donc on
  # la DÉMONTRE à l'exécution — eval(fold(e)) doit égaler eval(e). Z3 a déjà prouvé
  # que la passe termine et couvre chaque nœud.
  part main() -> Int via IO:
    let e = Add(Mul(Lit(3), Lit(4)), Neg(Lit(5)))   # (3*4) + (-5) = 7
    let delta = eval(fold(e)) - eval(e)             # 0 = sémantique préservée
    let d = IO.print(delta)                         # 0
    yield IO.print(eval(fold(e)))                   # 7 (arbre replié en Lit(7))
