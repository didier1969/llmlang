module ErpDoubleEntryVerified:

  # Double-entry bookkeeping: every entry balances, and the ledger stays balanced.
  #
  # Stated as invariant preservation under a guarded operation. `post` carries a `requires`
  # saying the entry is balanced, which the caller must discharge, and an `ensures` that
  # re-establishes a net of zero. Posting an unbalanced entry is therefore not something the
  # program checks and rejects — it is something the program cannot express.


  # A column total, debits or credits, equals the exact sum for any number of lines.
  part column_total(lines: List[Int]) -> Int:
    ensures result == sum(lines)
    measure length(lines)
    match lines:
      [] -> yield 0
      x :: rest -> yield x + column_total(rest)

  # An entry's imbalance is debits less credits, and is proved zero when the entry balances.
  part imbalance(debits: List[Int], credits: List[Int]) -> Int:
    requires sum(debits) == sum(credits)
    ensures result == 0
    yield column_total(debits) - column_total(credits)

  # Posting onto a balanced ledger is legal only for a balanced entry, and the `ensures`
  # re-establishes the balance for the next post.
  part post(net: Int, debits: List[Int], credits: List[Int]) -> Int:
    requires net == 0
    requires sum(debits) == sum(credits)
    ensures result == 0
    yield net + column_total(debits) - column_total(credits)

  part main() -> Int via IO:
    # Debits 100 + 50 against a credit of 150: imbalance 0, and the ledger's net stays 0.
    yield IO.print(post(0, [100, 50], [150]))
