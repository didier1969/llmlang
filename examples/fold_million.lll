module FoldMillion:

  # A permanent tripwire for the fold-to-loop transformation, at scale.
  #
  # `sum` is not a tail call — `h + sum(t)` still has work to do when the call returns — so
  # without that transformation a million elements overflow the stack. Both halves matter: the
  # computation AND the teardown, since dropping the list must be iterative too.
  #
  # This runs the full path, verify through optimise, code generation and execution, and fails
  # on any abort. A test that only inspected stdout would see nothing wrong.


  part build(n: Int) -> List[Int]:
    requires n >= 0
    measure n
    match n:
      0 -> yield []
      _ -> yield n :: build(n - 1)

  part sum(xs: List[Int]) -> Int:
    match xs:
      []     -> yield 0
      h :: t -> yield h + sum(t)

  part main() -> Int via IO:
    let xs = build(1000000)
    yield IO.print(sum(xs))
