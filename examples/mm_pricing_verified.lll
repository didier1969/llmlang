module MmPricing:

  # Pricing a line: base price, discount, tax — in exact integers.
  #
  # Amounts are in cents and rates in basis points, where 10000 bps is 100%. The usual shape,
  # `base_price * rate / 100.0`, computes money in floating point and rounds silently; nothing
  # there keeps the net price positive either. Both are settled here: the arithmetic is exact,
  # and non-negativity is proved for every valid input rather than for the cases someone tried.


  # Net price: base less discount, plus tax, both as basis points.
  part net_price(base: Int, disc_bps: Int, tax_bps: Int) -> Int:
    requires base >= 0
    requires disc_bps >= 0
    requires disc_bps <= 10000
    requires tax_bps >= 0
    ensures result >= 0
    let discount = base * disc_bps div 10000
    let taxable = base - discount
    let tax = taxable * tax_bps div 10000
    yield taxable + tax

  # A quote is monotone: applying a discount cannot raise the taxable amount.
  part taxable_after_discount(base: Int, disc_bps: Int) -> Int:
    requires base >= 0
    requires disc_bps >= 0
    requires disc_bps <= 10000
    ensures result >= 0
    ensures result <= base
    yield base - (base * disc_bps div 10000)

  part main() -> Int via IO:
    # 10000 cents, 15% off (1500 bps), 20% tax (2000 bps), giving exactly 10200.
    yield IO.print(net_price(10000, 1500, 2000))
