module ErpInventoryVerified:

  # Stock that can never be oversold.
  #
  # This is a PHYSICAL quantity under a capacity constraint, not money. The invariant is that
  # committed stock never exceeds stock on hand, so what is available stays non-negative. Every
  # operation carries a `requires` the caller must discharge and an `ensures` that re-establishes
  # the invariant for the next one, which is what makes negative stock unconstructible rather
  # than merely unlikely.


  # Available is on-hand less committed, proved non-negative.
  part available(on_hand: Int, committed: Int) -> Int:
    requires 0 <= committed
    requires committed <= on_hand
    ensures result >= 0
    ensures result == on_hand - committed
    yield on_hand - committed

  # Reserving is legal only up to what is available. The `ensures` re-establishes the invariant
  # so the next operation can discharge its own precondition from it.
  part reserve(on_hand: Int, committed: Int, qty: Int) -> Int:
    requires 0 <= committed
    requires committed <= on_hand
    requires 0 <= qty
    requires qty <= on_hand - committed
    ensures committed <= result
    ensures result <= on_hand
    yield committed + qty

  # The total committed over N reservations is their exact sum, for any N.
  part total_committed(reservations: List[Int]) -> Int:
    requires forall r in reservations: r >= 0
    ensures result == sum(reservations)
    ensures result >= 0
    measure length(reservations)
    match reservations:
      [] -> yield 0
      r :: rest -> yield r + total_committed(rest)

  # The same no-oversell invariant lifted from one reservation to a whole order book.
  part available_after(on_hand: Int, reservations: List[Int]) -> Int:
    requires forall r in reservations: r >= 0
    requires sum(reservations) <= on_hand
    ensures result >= 0
    ensures result == on_hand - sum(reservations)
    yield on_hand - total_committed(reservations)

  part main() -> Int via IO:
    # 100 on hand with 30 committed leaves 70 available; reserving 40 brings committed to 70.
    # An order book of [40, 20, 30] totals 90 against 100, leaving 10 available.
    yield IO.print(available_after(100, [40, 20, 30]))
