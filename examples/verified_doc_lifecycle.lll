module VerifiedDocLifecycle:

  # The lifecycle of an accounting document: Draft, Approved, Posted.
  #
  # This is workflow correctness rather than arithmetic. The status is a SUM TYPE, so the set
  # of states is closed, and each transition requires its legal starting state. Posting a draft
  # is therefore a compile error — the illegal transition cannot be written, rather than being
  # caught by a guard someone might forget.
  #
  # The invariant that matters to an auditor is that what was approved is exactly what gets
  # posted: the amount is proved to cross the whole cycle unchanged.


  type Status = Draft | Approved | Posted | Cancelled
  type Doc = {status: Status, amount: Int}

  # Only a draft can be approved. The amount is preserved.
  part approve(d: Doc) -> Doc:
    requires d.status == Draft
    requires d.amount >= 0
    ensures result.status == Approved
    ensures result.amount == d.amount
    yield Doc(Approved, d.amount)

  # Only an approved document can be posted, and it posts exactly the approved amount. A
  # caller reaching here from a draft cannot discharge the precondition, so the illegal
  # transition does not compile.
  part post(d: Doc) -> Doc:
    requires d.status == Approved
    ensures result.status == Posted
    ensures result.amount == d.amount
    yield Doc(Posted, d.amount)

  # The whole legal path composed: each step's precondition is discharged by the previous
  # step's `ensures`, and the amount is unchanged end to end.
  part process(amt: Int) -> Doc:
    requires amt >= 0
    ensures result.status == Posted
    ensures result.amount == amt
    yield post(approve(Doc(Draft, amt)))

  part main() -> Int via IO:
    # A document of 1500 cents goes Draft, Approved, Posted and still holds 1500.
    let d = process(1500)
    yield IO.print(d.amount)
