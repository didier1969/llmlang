module ErpProcureToPayVerified:

  # Procure to pay: receiving stock and posting the purchase, proved together.
  #
  # Two invariants have to hold on the same result. Stock grows by exactly the quantity
  # received, so a receipt can never shrink it; and the purchase entry balances, its debit to
  # stock equalling the credit to the supplier, so its net effect on the ledger is zero.


  type Receipt = {new_on_hand: Int, entry_net: Int}

  # Receiving grows stock by exactly the quantity received.
  part receive(on_hand: Int, qty: Int) -> Int:
    requires on_hand >= 0
    requires qty >= 0
    ensures result == on_hand + qty
    ensures result >= on_hand
    yield on_hand + qty

  # A purchase entry is only legal when balanced, and its net effect on the ledger is then zero.
  part purchase_posting(inventory_debit: Int, payable_credit: Int) -> Int:
    requires inventory_debit >= 0
    requires inventory_debit == payable_credit
    ensures result == 0
    yield inventory_debit - payable_credit

  # The composite: receive and post, proving both invariants of the same receipt. An unbalanced
  # purchase cannot be posted, because its precondition cannot be discharged.
  part procure(on_hand: Int, qty: Int, unit_debit: Int, unit_credit: Int) -> Receipt:
    requires on_hand >= 0
    requires qty >= 0
    requires unit_debit >= 0
    requires unit_debit == unit_credit
    ensures result.new_on_hand == on_hand + qty     # received exactly
    ensures result.new_on_hand >= on_hand           # a receipt never shrinks stock
    ensures result.entry_net == 0                   # the purchase balances
    yield Receipt(receive(on_hand, qty), purchase_posting(unit_debit, unit_credit))

  part main() -> Int via IO:
    # Receiving 50 into a stock of 100 gives 150; the purchase debits and credits 600, netting 0.
    let r = procure(100, 50, 600, 600)
    let a = IO.print(r.new_on_hand)
    yield IO.print(r.entry_net)
