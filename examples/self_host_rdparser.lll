module SelfHost.RdParser:

  # A real recursive-descent parser written in llmlang, handling precedence AND parentheses:
  #
  #   expr   := term (('+' | '-') term)*
  #   term   := factor ('*' factor)*
  #   factor := NUMBER | '(' expr ')'
  #
  # Parentheses are what make this hard. A toy parser can walk two parallel lists structurally;
  # nesting cannot, because it builds a tree. So the five parse functions are MUTUALLY
  # RECURSIVE and thread the remaining tokens through a `PR{ast, rem}` record — and the
  # termination argument has to work across that cycle.
  #
  # It rests on three things:
  #
  #   A LEXICOGRAPHIC MEASURE, `measure length(toks), rank`, compared as a tuple. Ranks run
  #   expr 4 > term 3 > exprRest 2 > termRest 1 > factor 0. Delegating expr to term consumes no
  #   token, so the length is EQUAL and it is the rank that decreases; an edge that does consume
  #   a token decreases the length, and lexicographic order then ignores the rank entirely.
  #   That is what lets the hard edge work — factor calling expr jumps rank 0 to 4, and is
  #   well-founded only because `(` was consumed first.
  #
  #   A CONTRACT ON THE REMAINDER, `ensures length(result.rem) <= length(toks)`. `result.rem`
  #   is a record selector, which the contract fragment admits; a call to a part would not be.
  #   The caller's measure obligation imports this contract, and without it no `(op factor)*`
  #   loop would terminate.
  #
  # Precedence and the parenthesis override are demonstrated at runtime by the values: 14 rather
  # than 20, and 13.


  type Tok  = TNum(Int) | TPlus | TMinus | TStar | TLParen | TRParen
  type Pend = NoPend | Pend(Int)
  type Expr = Lit(Int) | Add(Expr, Expr) | Sub(Expr, Expr) | Mul(Expr, Expr)
  type PR   = {ast: Expr, rem: List[Tok]}

  # ---- lexer: multi-digit accumulator, structural on the tail ----
  part push_digit(p: Pend, d: Int) -> Pend:
    match p:
      NoPend  -> yield Pend(d)
      Pend(v) -> yield Pend(v * 10 + d)

  part flush(p: Pend, rest: List[Tok]) -> List[Tok]:
    match p:
      NoPend  -> yield rest
      Pend(v) -> yield TNum(v) :: rest

  part lexA(s: List[Int], p: Pend) -> List[Tok]:
    match s:
      []     -> yield flush(p, [])
      h :: t ->
        match h:
          43 -> yield flush(p, TPlus :: lexA(t, NoPend))
          45 -> yield flush(p, TMinus :: lexA(t, NoPend))
          42 -> yield flush(p, TStar :: lexA(t, NoPend))
          40 -> yield flush(p, TLParen :: lexA(t, NoPend))
          41 -> yield flush(p, TRParen :: lexA(t, NoPend))
          d when d >= 48 and d <= 57 -> yield lexA(t, push_digit(p, d - 48))
          _  -> yield flush(p, lexA(t, NoPend))

  part lex(s: List[Int]) -> List[Tok]:
    yield lexA(s, NoPend)

  # ---- the parser: one mutually recursive group under the lexicographic measure ----

  # factor := NUMBER | '(' expr ')'          rank 0
  part parseFactor(toks: List[Tok]) -> PR:
    measure length(toks), 0
    ensures length(result.rem) <= length(toks)
    match toks:
      []     -> yield PR(Lit(0), [])
      h :: t ->
        match h:
          TNum(n) -> yield PR(Lit(n), t)
          TLParen ->
            match parseExpr(t):
              PR(e, r2) ->
                match r2:
                  []            -> yield PR(e, [])     # missing ')', recover
                  TRParen :: r3 -> yield PR(e, r3)     # constructor pattern in a cons head
                  hd :: r3      -> yield PR(e, r2)     # any other head, recover
          _       -> yield PR(Lit(0), toks)           # unexpected token, recover

  # the ('*' factor)* loop            rank 1
  part parseTermRest(left: Expr, toks: List[Tok]) -> PR:
    measure length(toks), 1
    ensures length(result.rem) <= length(toks)
    match toks:
      []      -> yield PR(left, [])
      op :: t ->
        match op:
          TStar ->
            match parseFactor(t):
              PR(r, rem) -> yield parseTermRest(Mul(left, r), rem)
          _     -> yield PR(left, toks)

  # the (('+'|'-') term)* loop        rank 2
  part parseExprRest(left: Expr, toks: List[Tok]) -> PR:
    measure length(toks), 2
    ensures length(result.rem) <= length(toks)
    match toks:
      []      -> yield PR(left, [])
      op :: t ->
        match op:
          TPlus ->
            match parseTerm(t):
              PR(r, rem) -> yield parseExprRest(Add(left, r), rem)
          TMinus ->
            match parseTerm(t):
              PR(r, rem) -> yield parseExprRest(Sub(left, r), rem)
          _     -> yield PR(left, toks)

  # term := factor ('*' factor)*      rank 3
  part parseTerm(toks: List[Tok]) -> PR:
    measure length(toks), 3
    ensures length(result.rem) <= length(toks)
    let PR(a, r) = parseFactor(toks)   # let-destructuring
    yield parseTermRest(a, r)

  # expr := term (('+'|'-') term)*    rank 4
  part parseExpr(toks: List[Tok]) -> PR:
    measure length(toks), 4
    ensures length(result.rem) <= length(toks)
    let PR(a, r) = parseTerm(toks)
    yield parseExprRest(a, r)

  part parse(toks: List[Tok]) -> Expr:
    let PR(e, r) = parseExpr(toks)
    yield e

  # ---- reference evaluator, structural on the AST ----
  part eval(e: Expr) -> Int:
    match e:
      Lit(n)    -> yield n
      Add(a, b) -> yield eval(a) + eval(b)
      Sub(a, b) -> yield eval(a) - eval(b)
      Mul(a, b) -> yield eval(a) * eval(b)

  # ---- runtime check of the whole chain: lex, parse, evaluate ----
  part main() -> Int via IO:
    let a = IO.print(eval(parse(lex("2+3*4"))))        # 14, not 20: precedence holds
    let b = IO.print(eval(parse(lex("(2+3)*4"))))      # 20: parentheses override it
    yield IO.print(eval(parse(lex("2*(3+4)-1"))))      # 13: nesting
