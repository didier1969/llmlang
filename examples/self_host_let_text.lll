module SelfHost.LetText:

  # Auto-hébergement étape 2 (DEC-LLL-024, PIL-LLL-007) — le CAPSTONE du track :
  # un pipeline COMPLET `texte source → tokens → AST → résultat` pour un mini-langage
  # AVEC VARIABLES, écrit EN llmlang, vérifié par Z3. Contrairement aux slices
  # précédents (qui lexaient seulement chiffres+opérateurs, ou construisaient l'AST à
  # la main), ici on LEXE un IDENTIFIANT et des MOTS-CLÉS (`let`/`in`) depuis du texte
  # brut, puis on RÉSOUT les noms via une table de symboles (`eqStr` sur `List[Int]`).
  # C'est le vrai stress de capacité : String = List[Int] de codepoints (DEC-LLL-030),
  # récursion STRUCTURALE partout (queue de la chaîne / de l'env) → terminaison prouvée
  # gratis, SANS `measure`.

  type Tok  = TNum(Int) | TId(List[Int]) | TLet | TIn | TEq | TPlus
  type Pend = NoPend | PNum(Int) | PId(List[Int])
  type Expr = Lit(Int) | Var(List[Int]) | Add(Expr, Expr) | Let(List[Int], Expr, Expr)
  type Env  = ENil | ECons(List[Int], Int, Env)

  # ---- égalité structurale de deux chaînes (codepoints). Structural sur `a`. ----
  part eqStr(a: List[Int], b: List[Int]) -> Bool:
    match a:
      []       ->
        match b:
          [] -> yield true
          _  -> yield false
      ha :: ta ->
        match b:
          []       -> yield false
          hb :: tb ->
            match ha == hb:
              true  -> yield eqStr(ta, tb)
              false -> yield false

  # ---- lexer : accumulateur 3-états (nombre / identifiant / rien). Structural sur `s`. ----
  part isDigit(c: Int) -> Bool:
    yield c >= 48 and c <= 57

  part isLower(c: Int) -> Bool:
    yield c >= 97 and c <= 122

  part snoc(xs: List[Int], c: Int) -> List[Int]:
    match xs:
      []     -> yield c :: []
      h :: t -> yield h :: snoc(t, c)

  # un run d'identifiant → mot-clé (`let`/`in`) ou TId. "let"=[108,101,116], "in"=[105,110].
  part classify(chars: List[Int]) -> Tok:
    match eqStr(chars, 108 :: 101 :: 116 :: []):
      true  -> yield TLet
      false ->
        match eqStr(chars, 105 :: 110 :: []):
          true  -> yield TIn
          false -> yield TId(chars)

  # émet l'opérateur/délimiteur `c` devant `rest` (espace/autre = sauté).
  part emitOp(c: Int, rest: List[Tok]) -> List[Tok]:
    match c == 61:                        # '='
      true  -> yield TEq :: rest
      false ->
        match c == 43:                    # '+'
          true  -> yield TPlus :: rest
          false -> yield rest             # espace (32) ou autre → sauté

  # vide l'accumulateur en fin de chaîne.
  part flushEnd(p: Pend) -> List[Tok]:
    match p:
      NoPend  -> yield []
      PNum(n) -> yield TNum(n) :: []
      PId(cs) -> yield classify(cs) :: []

  part lexA(s: List[Int], p: Pend) -> List[Tok]:
    match s:
      []     -> yield flushEnd(p)
      c :: t ->
        match isDigit(c):
          true  ->                        # chiffre : étend/démarre un nombre
            match p:
              NoPend  -> yield lexA(t, PNum(c - 48))
              PNum(n) -> yield lexA(t, PNum(n * 10 + (c - 48)))
              PId(cs) -> yield classify(cs) :: lexA(t, PNum(c - 48))
          false ->
            match isLower(c):
              true  ->                    # lettre : étend/démarre un identifiant
                match p:
                  NoPend  -> yield lexA(t, PId(c :: []))
                  PId(cs) -> yield lexA(t, PId(snoc(cs, c)))
                  PNum(n) -> yield TNum(n) :: lexA(t, PId(c :: []))
              false ->                    # délimiteur : vide le pending, émet l'op
                match p:
                  NoPend  -> yield emitOp(c, lexA(t, NoPend))
                  PNum(n) -> yield TNum(n) :: emitOp(c, lexA(t, NoPend))
                  PId(cs) -> yield classify(cs) :: emitOp(c, lexA(t, NoPend))

  part lex(s: List[Int]) -> List[Tok]:
    yield lexA(s, NoPend)

  # ---- parseur : `let ID = NUM in BODY`, BODY = somme `+` d'atomes. ----
  part atom(t: Tok) -> Expr:
    match t:
      TNum(n) -> yield Lit(n)
      TId(nm) -> yield Var(nm)
      _       -> yield Lit(0)             # token inattendu → sentinelle totale

  # plie la somme `+` gauche-associative. Structural sur `toks` (tête matchée séparément).
  part foldSum(acc: Expr, toks: List[Tok]) -> Expr:
    match toks:
      []        -> yield acc
      h :: rest ->
        match h:
          TPlus ->
            match rest:
              a :: more -> yield foldSum(Add(acc, atom(a)), more)
              []        -> yield acc       # `+` final → ignoré
          _ -> yield foldSum(acc, rest)    # token parasite → sauté

  part parseBody(toks: List[Tok]) -> Expr:
    match toks:
      []     -> yield Lit(0)
      h :: t -> yield foldSum(atom(h), t)

  # peèle le préfixe fixe `let ID = NUM in` — une chaîne de helpers, chacun matchant
  # la TÊTE à part. NB(gap REQ-LLL-110) : une tête de cons ne peut être un motif
  # constructeur (ni `TId(nm) :: r` ni `TLet :: r` — ce dernier bind un binder `TLet`
  # qui *shadow* le constructeur) ; seuls un binder ou `[]` sont admis en tête. D'où le
  # `h :: rest` + `match h` systématique. Tous non récursifs → terminaison triviale.
  part parseAfterNum(nm: List[Int], v: Int, toks: List[Tok]) -> Expr:
    match toks:                            # attend : `in` BODY
      []        -> yield Lit(0)
      h :: body ->
        match h:
          TIn -> yield Let(nm, Lit(v), parseBody(body))
          _   -> yield Lit(0)

  part parseAfterEq(nm: List[Int], toks: List[Tok]) -> Expr:
    match toks:                            # attend : NUM `in` BODY
      []        -> yield Lit(0)
      h :: rest ->
        match h:
          TNum(v) -> yield parseAfterNum(nm, v, rest)
          _       -> yield Lit(0)

  part parseAfterId(nm: List[Int], toks: List[Tok]) -> Expr:
    match toks:                            # attend : `=` NUM `in` BODY
      []        -> yield Lit(0)
      h :: rest ->
        match h:
          TEq -> yield parseAfterEq(nm, rest)
          _   -> yield Lit(0)

  part parseAfterLet(toks: List[Tok]) -> Expr:
    match toks:                            # attend : ID `=` NUM `in` BODY
      []        -> yield Lit(0)
      h :: rest ->
        match h:
          TId(nm) -> yield parseAfterId(nm, rest)
          _       -> yield Lit(0)

  part parse(toks: List[Tok]) -> Expr:
    match toks:
      []        -> yield Lit(0)
      h :: rest ->
        match h:
          TLet -> yield parseAfterLet(rest)
          _    -> yield parseBody(toks)    # pas de `let` → simple somme

  # ---- évaluateur à environnement nommé (table de symboles = assoc-list). ----
  part lookup(env: Env, nm: List[Int]) -> Int:
    match env:
      ENil -> yield 0                      # non lié → défaut 0
      ECons(k, v, rest) ->
        match eqStr(k, nm):
          true  -> yield v
          false -> yield lookup(rest, nm)

  part eval(e: Expr, env: Env) -> Int:
    match e:
      Lit(n)           -> yield n
      Var(nm)          -> yield lookup(env, nm)
      Add(a, b)        -> yield eval(a, env) + eval(b, env)
      Let(nm, b, body) -> yield eval(body, ECons(nm, eval(b, env), env))

  # ---- différentiel : du TEXTE SOURCE jusqu'au résultat, variables résolues par nom. ----
  part run(s: List[Int]) -> Int:
    yield eval(parse(lex(s)), ENil)

  part main() -> Int via IO:
    # "let x = 10 in x + x + 5" : x lexé (TId), tokenisé, parsé (Var), résolu à 10 → 25
    let a = IO.print(run("let x = 10 in x + x + 5"))   # 25
    # "let y = 7 in y + 3" : autre nom, même machinerie → 10
    yield IO.print(run("let y = 7 in y + 3"))          # 10
