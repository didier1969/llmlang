module SelfHost.LetText:

  # A complete pipeline for a small language WITH VARIABLES: source text to tokens to AST to a
  # result, written in llmlang.
  #
  # What makes this harder than lexing digits and operators is that identifiers and keywords
  # come out of raw text, and names then have to be RESOLVED through a symbol table. A string
  # is a `List[Int]` of codepoints, and the recursion is structural throughout — on the tail of
  # the string, or of the environment — so termination comes for free, with no `measure`.


  type Tok  = TNum(Int) | TId(List[Int]) | TLet | TIn | TEq | TPlus
  type Pend = NoPend | PNum(Int) | PId(List[Int])
  type Expr = Lit(Int) | Var(List[Int]) | Add(Expr, Expr) | Let(List[Int], Expr, Expr)
  type Env  = ENil | ECons(List[Int], Int, Env)

  # ---- structural equality of two strings ----
  part eqStr(a: List[Int], b: List[Int]) -> Bool:
    match a:
      []       ->
        match b:
          [] -> yield true
          _  -> yield false
      ha :: ta ->
        match b:
          []       -> yield false
          hb :: tb ->
            match ha == hb:
              true  -> yield eqStr(ta, tb)
              false -> yield false

  # ---- lexer: a three-state accumulator over number, identifier, or nothing ----
  part isDigit(c: Int) -> Bool:
    yield c >= 48 and c <= 57

  part isLower(c: Int) -> Bool:
    yield c >= 97 and c <= 122

  part snoc(xs: List[Int], c: Int) -> List[Int]:
    match xs:
      []     -> yield c :: []
      h :: t -> yield h :: snoc(t, c)

  # an identifier run becomes `let`, `in`, or a TId
  part classify(chars: List[Int]) -> Tok:
    match eqStr(chars, 108 :: 101 :: 116 :: []):
      true  -> yield TLet
      false ->
        match eqStr(chars, 105 :: 110 :: []):
          true  -> yield TIn
          false -> yield TId(chars)

  # emit the delimiter for `c` ahead of `rest`; spaces and anything else are skipped.
  part emitOp(c: Int, rest: List[Tok]) -> List[Tok]:
    match c == 61:                        # '='
      true  -> yield TEq :: rest
      false ->
        match c == 43:                    # '+'
          true  -> yield TPlus :: rest
          false -> yield rest             # space (32) or anything else, skipped

  # flush the accumulator at end of input.
  part flushEnd(p: Pend) -> List[Tok]:
    match p:
      NoPend  -> yield []
      PNum(n) -> yield TNum(n) :: []
      PId(cs) -> yield classify(cs) :: []

  part lexA(s: List[Int], p: Pend) -> List[Tok]:
    match s:
      []     -> yield flushEnd(p)
      c :: t ->
        match isDigit(c):
          true  ->                        # digit: extend or start a number
            match p:
              NoPend  -> yield lexA(t, PNum(c - 48))
              PNum(n) -> yield lexA(t, PNum(n * 10 + (c - 48)))
              PId(cs) -> yield classify(cs) :: lexA(t, PNum(c - 48))
          false ->
            match isLower(c):
              true  ->                    # letter: extend or start an identifier
                match p:
                  NoPend  -> yield lexA(t, PId(c :: []))
                  PId(cs) -> yield lexA(t, PId(snoc(cs, c)))
                  PNum(n) -> yield TNum(n) :: lexA(t, PId(c :: []))
              false ->                    # delimiter: flush, then emit
                match p:
                  NoPend  -> yield emitOp(c, lexA(t, NoPend))
                  PNum(n) -> yield TNum(n) :: emitOp(c, lexA(t, NoPend))
                  PId(cs) -> yield classify(cs) :: emitOp(c, lexA(t, NoPend))

  part lex(s: List[Int]) -> List[Tok]:
    yield lexA(s, NoPend)

  # ---- parser: `let ID = NUM in BODY`, where BODY is a `+` sum of atoms ----
  part atom(t: Tok) -> Expr:
    match t:
      TNum(n) -> yield Lit(n)
      TId(nm) -> yield Var(nm)
      _       -> yield Lit(0)             # unexpected token, total fallback

  # fold the left-associative `+` sum.
  part foldSum(acc: Expr, toks: List[Tok]) -> Expr:
    match toks:
      []        -> yield acc
      h :: rest ->
        match h:
          TPlus ->
            match rest:
              a :: more -> yield foldSum(Add(acc, atom(a)), more)
              []        -> yield acc       # a trailing `+` is ignored
          _ -> yield foldSum(acc, rest)    # stray token, skipped

  part parseBody(toks: List[Tok]) -> Expr:
    match toks:
      []     -> yield Lit(0)
      h :: t -> yield foldSum(atom(h), t)

  # Peel the fixed prefix `let ID = NUM in`, one helper per token.
  #
  # The repeated `h :: rest` followed by `match h` is not a stylistic choice: a cons head
  # cannot be a constructor pattern here. Writing `TLet :: r` binds a fresh variable named
  # `TLet` that shadows the constructor, which silently matches anything — only a binder or
  # `[]` is admitted in head position, so the head has to be matched separately.
  part parseAfterNum(nm: List[Int], v: Int, toks: List[Tok]) -> Expr:
    match toks:                            # expecting: `in` BODY
      []        -> yield Lit(0)
      h :: body ->
        match h:
          TIn -> yield Let(nm, Lit(v), parseBody(body))
          _   -> yield Lit(0)

  part parseAfterEq(nm: List[Int], toks: List[Tok]) -> Expr:
    match toks:                            # expecting: NUM `in` BODY
      []        -> yield Lit(0)
      h :: rest ->
        match h:
          TNum(v) -> yield parseAfterNum(nm, v, rest)
          _       -> yield Lit(0)

  part parseAfterId(nm: List[Int], toks: List[Tok]) -> Expr:
    match toks:                            # expecting: `=` NUM `in` BODY
      []        -> yield Lit(0)
      h :: rest ->
        match h:
          TEq -> yield parseAfterEq(nm, rest)
          _   -> yield Lit(0)

  part parseAfterLet(toks: List[Tok]) -> Expr:
    match toks:                            # expecting: ID `=` NUM `in` BODY
      []        -> yield Lit(0)
      h :: rest ->
        match h:
          TId(nm) -> yield parseAfterId(nm, rest)
          _       -> yield Lit(0)

  part parse(toks: List[Tok]) -> Expr:
    match toks:
      []        -> yield Lit(0)
      h :: rest ->
        match h:
          TLet -> yield parseAfterLet(rest)
          _    -> yield parseBody(toks)    # no `let`, just a sum

  # ---- evaluator with a named environment, held as an association list ----
  part lookup(env: Env, nm: List[Int]) -> Int:
    match env:
      ENil -> yield 0                      # unbound name, defaults to 0
      ECons(k, v, rest) ->
        match eqStr(k, nm):
          true  -> yield v
          false -> yield lookup(rest, nm)

  part eval(e: Expr, env: Env) -> Int:
    match e:
      Lit(n)           -> yield n
      Var(nm)          -> yield lookup(env, nm)
      Add(a, b)        -> yield eval(a, env) + eval(b, env)
      Let(nm, b, body) -> yield eval(body, ECons(nm, eval(b, env), env))

  # ---- runtime check: source text through to a result, names resolved ----
  part run(s: List[Int]) -> Int:
    yield eval(parse(lex(s)), ENil)

  part main() -> Int via IO:
    # `x` is lexed as an identifier, parsed as a variable, and resolved to 10.
    let a = IO.print(run("let x = 10 in x + x + 5"))   # 25
    # A different name through the same machinery.
    yield IO.print(run("let y = 7 in y + 3"))          # 10
