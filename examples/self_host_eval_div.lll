module SelfHost.EvalDiv:

  # An interpreter, written in llmlang, for a small language that has division.
  #
  # Euclidean division requires a divisor proved non-zero. So the meta-interpreter must itself
  # discharge the object language's division-by-zero obligation — the check is meta-circular.
  # The guard `eval(b) == 0` supplies `eval(b) != 0` on the `false` branch, which is exactly
  # what the proof needs. Remove the guard and this does not compile, because the divisor could
  # be zero: the language imposes its own discipline on its own interpreter.


  type Expr = Lit(Int) | Add(Expr, Expr) | Mul(Expr, Expr) | Div(Expr, Expr)

  part eval(e: Expr) -> Int:
    match e:
      Lit(n)    -> yield n
      Add(a, b) -> yield eval(a) + eval(b)
      Mul(a, b) -> yield eval(a) * eval(b)
      Div(a, b) ->
        let vb = eval(b)                        # bind the divisor once, so the guard and the
        match vb == 0:                          # division speak about the same term
          true  -> yield 0                      # zero divisor, return a sentinel
          false -> yield eval(a) div vb         # safe: the guard proves `vb != 0`

  part main() -> Int via IO:
    let ok = Div(Mul(Lit(2), Lit(5)), Add(Lit(1), Lit(1)))   # (2*5) / (1+1) is 5
    let dz = Div(Lit(10), Add(Lit(1), Lit(0 - 1)))           # 10 / 0, caught by the guard
    let a = IO.print(eval(ok))                                # 5
    yield IO.print(eval(dz))                                  # 0
