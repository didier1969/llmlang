module SelfHost.Optimize:

  # What an optimiser is FOR: constant folding shrinks the emitted bytecode.
  #
  # A wholly constant subtree folds to a single literal, so its code generation collapses from
  # several instructions to one. Where `self_host_constfold.lll` shows that folding preserves
  # meaning, this measures what it saves.


  type Expr  = Lit(Int) | Neg(Expr) | Add(Expr, Expr) | Sub(Expr, Expr) | Mul(Expr, Expr)
  type Instr = Push(Int) | INeg | IAdd | ISub | IMul

  part eval(e: Expr) -> Int:
    match e:
      Lit(n)    -> yield n
      Neg(a)    -> yield 0 - eval(a)
      Add(a, b) -> yield eval(a) + eval(b)
      Sub(a, b) -> yield eval(a) - eval(b)
      Mul(a, b) -> yield eval(a) * eval(b)

  # ---- the optimiser: constant folding, one helper per case ----
  part foldNeg(a: Expr) -> Expr:
    match a:
      Lit(x) -> yield Lit(0 - x)
      _      -> yield Neg(a)

  part foldAddL(x: Int, b: Expr) -> Expr:
    match b:
      Lit(y) -> yield Lit(x + y)
      _      -> yield Add(Lit(x), b)

  part foldAdd(a: Expr, b: Expr) -> Expr:
    match a:
      Lit(x) -> yield foldAddL(x, b)
      _      -> yield Add(a, b)

  part foldSubL(x: Int, b: Expr) -> Expr:
    match b:
      Lit(y) -> yield Lit(x - y)
      _      -> yield Sub(Lit(x), b)

  part foldSub(a: Expr, b: Expr) -> Expr:
    match a:
      Lit(x) -> yield foldSubL(x, b)
      _      -> yield Sub(a, b)

  part foldMulL(x: Int, b: Expr) -> Expr:
    match b:
      Lit(y) -> yield Lit(x * y)
      _      -> yield Mul(Lit(x), b)

  part foldMul(a: Expr, b: Expr) -> Expr:
    match a:
      Lit(x) -> yield foldMulL(x, b)
      _      -> yield Mul(a, b)

  part fold(e: Expr) -> Expr:
    match e:
      Lit(n)    -> yield Lit(n)
      Neg(a)    -> yield foldNeg(fold(a))
      Add(a, b) -> yield foldAdd(fold(a), fold(b))
      Sub(a, b) -> yield foldSub(fold(a), fold(b))
      Mul(a, b) -> yield foldMul(fold(a), fold(b))

  # ---- back end: post-order code generation, plus an instruction count ----
  part iappend(xs: List[Instr], ys: List[Instr]) -> List[Instr]:
    match xs:
      []     -> yield ys
      h :: t -> yield h :: iappend(t, ys)

  part compile(e: Expr) -> List[Instr]:
    match e:
      Lit(n)    -> yield Push(n) :: []
      Neg(a)    -> yield iappend(compile(a), INeg :: [])
      Add(a, b) -> yield iappend(compile(a), iappend(compile(b), IAdd :: []))
      Sub(a, b) -> yield iappend(compile(a), iappend(compile(b), ISub :: []))
      Mul(a, b) -> yield iappend(compile(a), iappend(compile(b), IMul :: []))

  part ilen(p: List[Instr]) -> Int:
    match p:
      []     -> yield 0
      h :: t -> yield 1 + ilen(t)

  # ---- the check: meaning preserved AND bytecode shorter ----
  part main() -> Int via IO:
    let e = Add(Mul(Lit(3), Lit(4)), Lit(5))       # (3*4)+5, wholly constant
    let delta = eval(fold(e)) - eval(e)            # 0: folding preserved the meaning
    let d = IO.print(delta)                         # 0
    let raw = IO.print(ilen(compile(e)))            # 5: push, push, mul, push, add
    yield IO.print(ilen(compile(fold(e))))          # 1: a single push of 17
