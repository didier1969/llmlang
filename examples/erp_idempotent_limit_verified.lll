module ErpIdempotentLimitVerified:

  # Enforcing a limit is idempotent: applying it twice is applying it once.
  #
  # This matters wherever a message can be replayed — a network retry, a duplicated event, a
  # batch run again. Capping a credit exposure a second time must change nothing, and here the
  # difference between one application and two is proved to be zero.


  # Cap an exposure at the limit, bounded by both.
  part enforce_limit(exposure: Int, limit: Int) -> Int:
    requires exposure >= 0
    requires limit >= 0
    ensures result >= 0
    ensures result <= limit
    ensures result <= exposure
    yield if exposure <= limit then exposure else limit

  # Re-applying to an already-capped value is proved to change nothing. This is half of
  # idempotence: the function no longer moves its own output.
  part reapply(limited: Int, limit: Int) -> Int:
    requires 0 <= limited
    requires limited <= limit
    ensures result == limited
    yield if limited <= limit then limited else limit

  # And the other half: the difference between one application and two is zero.
  part idempotent_diff(exposure: Int, limit: Int) -> Int:
    requires exposure >= 0
    requires limit >= 0
    ensures result == 0
    let capped = enforce_limit(exposure, limit)
    yield capped - reapply(capped, limit)

  part main() -> Int via IO:
    # An exposure of 900 caps to 500; capping again leaves 500, for a difference of 0.
    yield IO.print(idempotent_diff(900, 500))
