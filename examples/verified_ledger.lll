module VerifiedLedger:

  # A ledger's total is exactly the sum of its entries, for any number of entries.
  #
  # "Does the total match the entries?" and "does reorganising the lines preserve the balance?"
  # are audit questions a conventional system answers by testing a few data sets. Here `sum` is
  # a specification term, axiomatised as `sum([]) = 0` and `sum(h :: t) = h + sum(t)`, so the
  # conservation can be STATED in a contract and proved by structural recursion for a list of
  # symbolic length.
  #
  # In exact integers there is also nothing to accumulate: a float total drifts from the true
  # one as the ledger grows, and no amount of testing finds the size at which it starts to.


  # The computed total equals the true sum, for any length: the induction hypothesis plus the
  # axioms of `sum`.
  part ledger_total(entries: List[Int]) -> Int:
    ensures result == sum(entries)
    measure length(entries)
    match entries:
      [] -> yield 0
      e :: rest -> yield e + ledger_total(rest)

  # Splitting the first entry into two parts that recompose it leaves the total unchanged —
  # the audit invariant behind any line-level reallocation.
  part split_first(entries: List[Int], k: Int) -> List[Int]:
    ensures sum(result) == sum(entries)
    match entries:
      [] -> yield []
      e :: rest -> yield k :: (e - k) :: rest

  part main() -> Int via IO:
    # 100 + 250 - 50 + 300 = 600. Splitting the first line into 40 + 60 leaves it at 600.
    let t = IO.print(ledger_total([100, 250, -50, 300]))
    yield IO.print(ledger_total(split_first([100, 250, -50, 300], 40)))
