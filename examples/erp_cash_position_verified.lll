module ErpCashPositionVerified:

  # A cash position fed only by receipts never falls below its opening balance.
  #
  # The accumulator here CHANGES as the fold proceeds — it grows — but stays bounded from
  # below. That is a different shape from preserving an equality: it is the invariant of any
  # account that only ever moves one way, such as a receipts-only balance or an audit counter,
  # and it is proved for a sequence of any length.


  type Receipt = {amount: Int}

  # A receipt can only raise the balance.
  part apply_receipt(balance: Int, r: Receipt) -> Int:
    requires 0 <= r.amount
    ensures result >= balance
    ensures result == balance + r.amount
    yield balance + r.amount

  # Replaying a sequence of receipts closes at or above the opening balance, for any sequence.
  # At `h :: t` the head can only raise the balance, and the hypothesis carries the floor
  # through the tail.
  part cash_position(opening: Int, receipts: List[Receipt]) -> Int:
    requires forall r in receipts: 0 <= r.amount
    ensures result >= opening
    measure length(receipts)
    match receipts:
      [] -> yield opening
      h :: t -> yield cash_position(apply_receipt(opening, h), t)

  part main() -> Int via IO:
    # Opening 5000, three receipts, closing 10000 — proved never below the opening.
    let day = [Receipt(1200), Receipt(800), Receipt(3000)]
    yield IO.print(cash_position(5000, day))
