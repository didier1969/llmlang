module ActorReactive:

  # An actor's BEHAVIOUR needs nothing beyond the ordinary language.
  #
  # A message is a sum type, so what would be a `receive` elsewhere becomes an EXHAUSTIVE match:
  # every message is handled by construction, not by convention.

  type Msg = Add(Int) | Reset

  # Clamp to zero, with no precondition of its own.
  part max0(x: Int) -> Int:
    ensures result >= 0
    match x >= 0:
      true  -> yield x
      false -> yield 0

  # The behaviour: a total step function from state and message to the next state. There is no
  # loop here — an actor's non-terminating loop lives in the runtime, which is what lets every
  # part in the language still have a termination proof. The invariant that state never goes
  # negative holds for EVERY message, whatever the sequence.
  part step(state: Int, m: Msg) -> Int:
    requires state >= 0
    ensures result >= 0
    match m:
      Add(k) -> yield max0(state + k)
      Reset  -> yield 0

  # The driver, shown bounded here: the real unbounded stream is the runtime's business.
  part run(state: Int, inbox: List[Msg]) -> Int:
    requires state >= 0
    ensures result >= 0
    match inbox:
      []     -> yield state
      m :: t -> yield run(step(state, m), t)

  part main() -> Int via IO:
    let inbox = Add(5) :: Add(3) :: Reset :: Add(7) :: []
    yield IO.print(run(0, inbox))   # +5, +3, reset, +7
