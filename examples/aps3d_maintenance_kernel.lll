module Aps3d.Kernel:

  # The pure rule-evaluation kernel for equipment maintenance. A library module with no `main`,
  # imported by both the in-memory demo and the persisted ones, so there is one source of truth.
  #
  # The match on `Condition` is EXHAUSTIVE. In the engine this was ported from, a catch-all
  # `condition_matches?(_, _) -> false` made a misspelled condition silently inert — it simply
  # never fired, and nothing said so. Here the same mistake fails to compile.


  # Aggregated facts about one piece of equipment, compared as integers.
  type Facts = {max_wear: Int, min_days: Int}

  # Adding a condition over an existing fact costs two lines: a variant here, and an arm in
  # `cond_holds`. Forgetting the arm does not compile, so a half-wired condition cannot exist.
  type Condition = WearAbove(Int) | DaysBelow(Int) | WearBelow(Int)

  # The actions a rule can emit.
  type Action = Alert(Int) | Schedule(Int)

  # A rule is a conjunction of conditions leading to one action.
  type Rule = {conds: List[Condition], act: Action}

  # Evaluate one condition. No catch-all, so no silent fallback.
  part cond_holds(c: Condition, f: Facts) -> Bool:
    match c:
      WearAbove(t) -> yield f.max_wear > t
      DaysBelow(t) -> yield f.min_days < t
      WearBelow(t) -> yield f.max_wear < t

  # All conditions hold.
  part all_hold(cs: List[Condition], f: Facts) -> Bool:
    match cs:
      []     -> yield true
      c :: r ->
        match cond_holds(c, f):
          true  -> yield all_hold(r, f)
          false -> yield false

  # A rule matches when all of its conditions do.
  part matches(rl: Rule, f: Facts) -> Bool:
    yield all_hold(rl.conds, f)

  # The kernel: the actions of every matching rule, in priority order.
  part evaluate(rules: List[Rule], f: Facts) -> List[Action]:
    match rules:
      []      -> yield []
      rl :: r ->
        match matches(rl, f):
          true  -> yield rl.act :: evaluate(r, f)
          false -> yield evaluate(r, f)

  # How many actions were emitted.
  part len(xs: List[Action]) -> Int:
    match xs:
      []     -> yield 0
      h :: t -> yield 1 + len(t)

  # Severity is proved to land in [0, 3] for ANY input, which removes the out-of-range class
  # of bug rather than testing for it.
  part severity(f: Facts) -> Int:
    ensures result >= 0
    ensures result <= 3
    match f.min_days < 7:
      true  -> yield 3
      false ->
        match f.max_wear > 90:
          true  -> yield 3
          false ->
            match f.max_wear > 75:
              true  ->
                match f.min_days < 30:
                  true  -> yield 2
                  false -> yield 0
              false -> yield 0
