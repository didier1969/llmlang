module SelfHost.LetEnv:

  # Auto-hébergement étape 2 (DEC-LLL-024, PIL-LLL-007) : un interpréteur self-hosté
  # d'un mini-langage AVEC LIAISON DE VARIABLES (`let`) — une vraie machinerie
  # d'interpréteur (environnement, binding, lookup), au-delà de l'arithmétique. Écrit
  # EN llmlang, vérifié par Z3. Les variables sont indexées par Int (rang de De
  # Bruijn) et l'environnement est une `List[Int]` (le rang 0 = liaison la plus
  # récente). `eval` file l'environnement ; `Let(b, body)` évalue `b`, l'empile, puis
  # évalue `body` dans l'env étendu ; `Var(i)` cherche le rang `i`. Tout STRUCTURAL
  # (sous-arbres / queue de l'env) → terminaison prouvée gratis.

  type Expr = Lit(Int) | Var(Int) | Add(Expr, Expr) | Mul(Expr, Expr) | Let(Expr, Expr)

  # lookup du rang `i` dans l'environnement. Structural sur l'env ; `i` décroît.
  part nth(env: List[Int], i: Int) -> Int:
    match env:
      []     -> yield 0                        # hors portée → défaut 0
      h :: t ->
        match i == 0:
          true  -> yield h
          false -> yield nth(t, i - 1)

  # évaluateur à environnement. Structural sur l'AST `e`.
  part eval(e: Expr, env: List[Int]) -> Int:
    match e:
      Lit(n)    -> yield n
      Var(i)    -> yield nth(env, i)
      Add(a, b) -> yield eval(a, env) + eval(b, env)
      Mul(a, b) -> yield eval(a, env) * eval(b, env)
      Let(b, body) ->
        let vb = eval(b, env)                  # évalue la liaison
        yield eval(body, vb :: env)            # corps dans l'env étendu (rang 0 = vb)

  # ---- différentiel runtime : liaison + lookup + portée imbriquée.
  part main() -> Int via IO:
    # let x = 10 in x + x  = 20
    let e1 = Let(Lit(10), Add(Var(0), Var(0)))
    let a = IO.print(eval(e1, []))             # 20
    # let x = 6 in (let y = 7 in x * y)  = 42  (Var(1)=x sous le y interne, Var(0)=y)
    let e2 = Let(Lit(6), Let(Lit(7), Mul(Var(1), Var(0))))
    yield IO.print(eval(e2, []))               # 42
