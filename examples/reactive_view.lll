module Reactive:

  # A reactive view over actor state, using nothing but ordinary pure parts.
  #
  # `view(state)` is a pure derivation of the state, the way a render function is, but total and
  # verified. `diff(old, new)` computes the minimal delta between two successive views: either
  # nothing changed, or the new value has to be pushed. The delta is deliberately the simplest
  # possible — replace the whole value — rather than a structural patch.


  type Delta = NoChange | Changed(Int)

  # The view: a pure derivation of the actor's state. Doubling stands in for any such
  # projection.
  part view(state: Int) -> Int:
    yield state * 2

  # The contract proves the decidable half — WHETHER the view changed: `result == NoChange`
  # exactly when the two views are equal.
  #
  # It does not prove the value CARRIED by `Changed`. The contract fragment admits a reference
  # to a nullary constructor such as `NoChange`, but not the CONSTRUCTION of `Changed(v)`, so
  # the payload is outside what can be stated here. It is correct by reading the one-line body,
  # and exercised by the `example` clauses rather than by a proof.
  part diff(old_view: Int, new_view: Int) -> Delta:
    ensures (old_view == new_view) == (result == NoChange)
    example diff(0, 0) == NoChange
    example diff(0, 6) != NoChange
    match old_view == new_view:
      true  -> yield NoChange
      false -> yield Changed(new_view)

  # The driver a runtime would use: view after each step, and push the diff only when it says
  # something changed. One delta per consecutive PAIR of states, over a sliding window. This is
  # bounded and pure; the unbounded loop belongs to the runtime, not here.
  part drive(states: List[Int]) -> List[Delta]:
    match states:
      []     -> yield []
      s :: t ->
        match t:
          []       -> yield []
          s2 :: t2 -> yield diff(view(s), view(s2)) :: drive(t)

  part main() -> Int via IO:
    let states = 0 :: 3 :: 3 :: 5 :: []
    let deltas = drive(states)
    match deltas:
      []      -> yield IO.print(-2)
      d :: rest ->
        match d:
          Changed(v) -> yield IO.print(v)   # first delta: view(0)=0 -> view(3)=6
          NoChange    -> yield IO.print(-1)
