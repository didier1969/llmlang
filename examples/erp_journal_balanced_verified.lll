module ErpJournalBalancedVerified:

  # The books stay balanced over the WHOLE history, not one transaction at a time.
  #
  # The invariant is a system-level one over a journal of arbitrary length: if every entry is
  # balanced, meaning debit equals credit, then the trial balance of the entire journal is
  # zero. It is proved by structural recursion, so it holds for any sequence of transactions
  # rather than for the ones a test happened to try.
  #
  # That is the foundation of double-entry bookkeeping stated as a theorem: a ledger that
  # drifts out of balance cannot be constructed, because the contract rejects it.

  type Entry = {debit: Int, credit: Int}

  # An entry's effect on the trial balance is debit minus credit, hence zero when balanced.
  part entry_net(e: Entry) -> Int:
    requires e.debit == e.credit
    ensures result == 0
    yield e.debit - e.credit

  # The inductive step, at `h :: t`: the head predicate gives `entry_net(h) == 0`, the `forall`
  # propagates to the tail so the recursive precondition holds, and the hypothesis gives
  # `trial_balance(t) == 0`. Zero plus zero.
  part trial_balance(js: List[Entry]) -> Int:
    requires forall e in js: e.debit == e.credit
    ensures result == 0
    measure length(js)
    match js:
      [] -> yield 0
      h :: t -> yield entry_net(h) + trial_balance(t)

  # ---- the same fact from the other side: preservation under a fold ----
  # Applying a balanced entry to a running balance leaves it unchanged.
  part post(balance: Int, e: Entry) -> Int:
    requires e.debit == e.credit
    ensures result == balance
    yield balance + entry_net(e)

  # Replaying a whole journal onto an opening balance closes at exactly that opening balance.
  # This is stronger than the aggregate being zero: it says no drift accumulates, for any
  # balanced sequence.
  part replay(opening: Int, js: List[Entry]) -> Int:
    requires forall e in js: e.debit == e.credit
    ensures result == opening
    measure length(js)
    match js:
      [] -> yield opening
      h :: t -> yield replay(post(opening, h), t)

  part main() -> Int via IO:
    # Three balanced transactions: a purchase, a sale, a cash receipt.
    let journal = [Entry(1000, 1000), Entry(500, 500), Entry(750, 750)]
    # Trial balance zero, proved for the whole sequence rather than line by line.
    let tb = IO.print(trial_balance(journal))
    # Replayed onto an opening balance of 4200, it closes at 4200.
    yield IO.print(replay(4200, journal))
