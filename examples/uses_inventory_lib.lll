import "lib/inventory_lib.lll"

module UsesInventoryLib:

  # A cross-module consumer of the verified inventory module.
  #
  # It composes the imported guarantees without re-proving them: the no-oversell bound on
  # `can_fulfill` is discharged from `stock_reserve`'s contract, across the
  # A genuinely cross-file call: `can_fulfill` here calls `stock_reserve`, defined in
  # `lib/inventory_lib.lll`. Single-file tooling misses that edge; it is exactly the edge a
  # cross-module index has to carry.
  # import boundary.

  # Fulfilling an order by reserving stock. The no-oversell guarantee comes from the library.
  part can_fulfill(on_hand: Int, committed: Int, order: Int) -> Int:
    requires 0 <= committed
    requires committed <= on_hand
    requires 0 <= order
    requires order <= on_hand - committed
    ensures result <= on_hand
    yield stock_reserve(on_hand, committed, order)

  part main() -> Int via IO:
    # 100 on hand with 30 committed leaves 70 available; ordering 40 brings committed to 70.
    yield IO.print(can_fulfill(100, 30, 40))
