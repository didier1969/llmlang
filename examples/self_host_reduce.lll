module SelfHost.Reduce:

  # A compiler pass whose termination genuinely needs a list-length measure.
  #
  # `reduce` folds adjacent triples `TNum a, TPlus, TNum b` into `TNum (a+b)` over a token
  # stream. The fold CONSUMES three tokens and PRODUCES one, then re-reduces the result — so
  # the recursion is not structural, since it rebuilds the list. Termination holds only because
  # the LENGTH strictly decreases, which is exactly what `measure length(toks)` states.


  type Tok = TNum(Int) | TPlus

  # A cons head cannot be a constructor pattern, so `TNum(a) :: rest` will not do what it
  # looks like. The head is bound to a variable and matched separately, which is why the
  # matches below are nested rather than flat.
  part reduce(toks: List[Tok]) -> List[Tok]:
    measure length(toks)
    match toks:
      [] -> yield []
      h :: rest1 ->
        match h:
          TPlus  -> yield h :: reduce(rest1)          # head not foldable, recurse on the tail
          TNum(a) ->
            match rest1:
              [] -> yield h :: []
              h2 :: rest2 ->
                match h2:
                  TNum(x) -> yield h :: reduce(rest1)  # two numbers, no `+` between them
                  TPlus ->
                    match rest2:
                      [] -> yield h :: h2 :: []
                      h3 :: rest3 ->
                        match h3:
                          TPlus   -> yield h :: reduce(rest1)          # `+ +`, nothing to fold
                          TNum(b) -> yield reduce(TNum(a + b) :: rest3) # fold: three tokens become one

  # the value of the first `TNum`, used by the runtime check below.
  part firstNum(toks: List[Tok]) -> Int:
    match toks:
      [] -> yield 0
      h :: t ->
        match h:
          TNum(a) -> yield a
          TPlus   -> yield firstNum(t)

  # ---- runtime check: reduce a known stream and print what it folded to ----
  part main() -> Int via IO:
    # [3, +, 4, +, 5] folds to [7, +, 5], then to [12]
    let toks = TNum(3) :: TPlus :: TNum(4) :: TPlus :: TNum(5) :: []
    let a = IO.print(firstNum(reduce(toks)))        # 12
    # [8, +, 9] folds to [17]
    let toks2 = TNum(8) :: TPlus :: TNum(9) :: []
    yield IO.print(firstNum(reduce(toks2)))         # 17
