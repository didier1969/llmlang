module ErpSequenceVerified:

  # Gap-free document numbering.
  #
  # An ordering invariant: each number is the immediate successor of the last. A gap means a
  # missing document, which is a fraud signal and an audit failure — so `record` requires
  # `num == last + 1`, and a number that skips cannot be recorded at all.


  # The next number: the immediate successor, strictly increasing.
  part issue(last: Int) -> Int:
    requires last >= 0
    ensures result == last + 1
    ensures result > last
    yield last + 1

  # Recording is legal only for the immediate successor: no gap, and no duplicate either.
  part record(last: Int, num: Int) -> Int:
    requires last >= 0
    requires num == last + 1
    ensures result == num
    ensures result == last + 1
    yield num

  # Issuing N numbers advances the counter by exactly N, so they are N distinct contiguous
  # numbers, for any N.
  part span(start: Int, n: Int) -> Int:
    requires start >= 0
    requires n >= 0
    ensures result == start + n
    ensures result >= start
    measure n
    yield if n == 0 then start else span(start, n - 1) + 1

  part main() -> Int via IO:
    # After 1000 the next is 1001, which records cleanly; issuing five from 1000 ends at 1005.
    let a = IO.print(record(1000, issue(1000)))
    yield IO.print(span(1000, 5))
