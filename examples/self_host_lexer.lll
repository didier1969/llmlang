module SelfHost.Lexer:

  # The lexer for the small `Expr` language, written in llmlang. A string is a `List[Int]` of
  # codepoints, so the literal "12*34" desugars into that list.
  #
  # Multi-digit numbers are handled with an ACCUMULATOR: the number being read is carried in a
  # `Pend` parameter and flushed at the next non-digit. Every case recurses on the direct tail,
  # so the recursion is structural and termination needs no `measure` on the list.


  type Tok  = TNum(Int) | TPlus | TMinus | TStar
  type Pend = NoPend | Pend(Int)

  # accumulate one digit into the number being read.
  part push_digit(p: Pend, d: Int) -> Pend:
    match p:
      NoPend  -> yield Pend(d)
      Pend(v) -> yield Pend(v * 10 + d)

  # emit the pending number, if any, ahead of the remaining tokens.
  part flush(p: Pend, rest: List[Tok]) -> List[Tok]:
    match p:
      NoPend  -> yield rest
      Pend(v) -> yield TNum(v) :: rest

  # 43 is '+', 45 '-', 42 '*', 32 space, 48..57 the digits.
  part lexA(s: List[Int], p: Pend) -> List[Tok]:
    match s:
      []     -> yield flush(p, [])
      h :: t ->
        match h:
          43 -> yield flush(p, TPlus :: lexA(t, NoPend))
          45 -> yield flush(p, TMinus :: lexA(t, NoPend))
          42 -> yield flush(p, TStar :: lexA(t, NoPend))
          d when d >= 48 and d <= 57 -> yield lexA(t, push_digit(p, d - 48))
          _  -> yield flush(p, lexA(t, NoPend))    # space or unknown: flush, then skip

  part lex(s: List[Int]) -> List[Tok]:
    yield lexA(s, NoPend)

  # ---- runtime check: lex a known string and pin the result ----

  part tok_count(ts: List[Tok]) -> Int:
    match ts:
      []     -> yield 0
      h :: t -> yield 1 + tok_count(t)

  # One code per kind, the value itself for TNum, so the signature encodes the whole sequence.
  part tok_val(x: Tok) -> Int:
    match x:
      TNum(n) -> yield n
      TPlus   -> yield 100
      TMinus  -> yield 200
      TStar   -> yield 300

  part tok_sig(ts: List[Tok]) -> Int:
    match ts:
      []     -> yield 0
      h :: t -> yield tok_val(h) + tok_sig(t)

  part main() -> Int via IO:
    let toks = lex("12*34+5")            # [TNum(12), TStar, TNum(34), TPlus, TNum(5)]
    let c = IO.print(tok_count(toks))    # 5 tokens: the digits were grouped
    yield IO.print(tok_sig(toks))        # 12 + 300 + 34 + 100 + 5 = 451
