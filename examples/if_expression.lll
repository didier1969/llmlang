module IfExpression:

  # `if c then a else b` as an EXPRESSION, usable anywhere a value is expected — an argument, a
  # `yield`, the element of a cons.
  #
  # Two things follow from that. Nesting in the `else` gives `elif` for nothing. And the
  # verification is PATH-SENSITIVE: inside `then` the condition is assumed, inside `else` its
  # negation is. So `n div d` under the `else` of a `d == 0` guard is proved safe without any
  # separate check — the division obligation inherits the branch condition.


  # Safe division: the `else` branch carries `d != 0`, which discharges the obligation.
  part safeDiv(n: Int, d: Int) -> Int:
    yield if d == 0 then 0 else n div d

  # An elif chain, nested in the `else`: every branch produces a value in [-1, 1].
  part sign(x: Int) -> Int:
    ensures result >= -1 and result <= 1
    yield if x < 0 then -1 else if x == 0 then 0 else 1

  part main() -> Int via IO:
    let a = IO.print(safeDiv(10, 0))    # 0, caught by the guard
    let b = IO.print(safeDiv(20, 4))    # 5
    let c = IO.print(sign(-7))          # -1
    yield IO.print(sign(3))             # 1
