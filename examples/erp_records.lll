module Erp:

  # RECORDS with named fields (REQ-LLL-070). A record is a mono-ctor product;
  # positional construction `LineItem(3, 250)` is the plain constructor call, and
  # named access `li.qty` is a checker-level PROJECTION PRIMITIVE lowered to the
  # Z3 datatype selector `(LineItem_0 …)` — legal in a contract (unlike a user
  # `part`, DEC-LLL-017). That is the whole point of records for an ERP: a business
  # rule stated OVER A FIELD is PROVEN, not merely typed.

  type LineItem = {qty: Int, unit_price: Int}
  type Invoice  = {item: LineItem, tax_bps: Int}

  # The extended amount of a line, PROVEN non-negative from the field
  # preconditions: "a line total is never negative" is a discharged obligation.
  part amount(li: LineItem) -> Int:
    requires li.qty >= 0
    requires li.unit_price >= 0
    ensures result >= 0
    yield li.qty * li.unit_price

  # The gross of an invoice reaches THROUGH a nested record field
  # (`inv.item.qty`): the selectors compose as `(LineItem_0 (Invoice_0 inv))`,
  # each legal in the contract, so the same non-negativity invariant is proven
  # one level down.
  part gross(inv: Invoice) -> Int:
    requires inv.item.qty >= 0
    requires inv.item.unit_price >= 0
    ensures result >= 0
    yield inv.item.qty * inv.item.unit_price

  # 750 + 200 = 950. The caller CONSTRUCTS the records positionally (nested), and
  # each call discharges the field preconditions on a freshly-built record.
  part main() -> Int:
    yield amount(LineItem(3, 250)) + gross(Invoice(LineItem(2, 100), 875))
