module MatteRefine:

  # ── BRIQUE CERTIFIÉE : raffinage de masque alpha (post-détourage IA) ──
  # Seuillage doux d'un canal alpha. INVARIANT PROUVÉ : tout pixel de sortie ∈ [0,255],
  # index jamais hors bornes, longueur du masque préservée — pour un masque de taille
  # QUELCONQUE. Un noyau C/Kotlin ne garantit AUCUN des trois ; ici ce sont des théorèmes.

  part refine_px(a: Int, low: Int, high: Int) -> Int:
    requires 0 <= a, a <= 255
    requires 0 <= low, low < high, high <= 255
    ensures 0 <= result, result <= 255
    match a <= low:
      true  -> yield 0
      false ->
        match a >= high:
          true  -> yield 255
          false -> yield ((a - low) * 255) div (high - low)

  # balaye src (masque brut) → dst (masque raffiné), pixel par pixel. Bornes prouvées,
  # length préservée. (L'invariant [0,255] tient par pixel via refine_px ; le threader
  # sur TOUT dst à N symbolique = une tranche de plus, non requise pour la sûreté mémoire.)
  part sweep(src: Array[Int], dst: Array[Int], i: Int, low: Int, high: Int) -> Array[Int]:
    requires length(src) == length(dst)
    requires 0 <= i, i <= length(src)
    requires 0 <= low, low < high, high <= 255
    requires forall k in 0 .. length(src): 0 <= get(src, k)
    requires forall k in 0 .. length(src): get(src, k) <= 255
    ensures length(result) == length(src)
    measure length(src) - i
    match i >= length(src):
      true  -> yield dst
      false -> yield sweep(src, set(dst, i, refine_px(get(src, i), low, high)), i + 1, low, high)

  part main() -> Int via IO:
    let raw = array(10, 200, 128, 40, 250, 5, 180)
    let dst = array(0, 0, 0, 0, 0, 0, 0)
    let out = sweep(raw, dst, 0, 50, 200)
    let a = IO.print(get(out, 2))    # 128 → (128-50)*255/150 = 132
    yield IO.print(length(out))      # 7 (préservée)
