module MatteRefine:

  # Soft thresholding of an alpha channel.
  #
  # Three things are proved for a mask of ANY size: every output pixel lands in [0, 255], no
  # index goes out of bounds, and the mask's length is preserved. A pixel loop written in C
  # guarantees none of the three.


  part refine_px(a: Int, low: Int, high: Int) -> Int:
    requires 0 <= a, a <= 255
    requires 0 <= low, low < high, high <= 255
    ensures 0 <= result, result <= 255
    match a <= low:
      true  -> yield 0
      false ->
        match a >= high:
          true  -> yield 255
          false -> yield ((a - low) * 255) div (high - low)

  # Sweep the source mask into the refined one, pixel by pixel. The [0, 255] invariant holds per
  # pixel through `refine_px`; threading it over the whole destination at symbolic N is a
  # further step, and is not what memory safety rests on here.
  part sweep(src: Array[Int], dst: Array[Int], i: Int, low: Int, high: Int) -> Array[Int]:
    requires length(src) == length(dst)
    requires 0 <= i, i <= length(src)
    requires 0 <= low, low < high, high <= 255
    requires forall k in 0 .. length(src): 0 <= get(src, k)
    requires forall k in 0 .. length(src): get(src, k) <= 255
    ensures length(result) == length(src)
    measure length(src) - i
    match i >= length(src):
      true  -> yield dst
      false -> yield sweep(src, set(dst, i, refine_px(get(src, i), low, high)), i + 1, low, high)

  part main() -> Int via IO:
    let raw = array(10, 200, 128, 40, 250, 5, 180)
    let dst = array(0, 0, 0, 0, 0, 0, 0)
    let out = sweep(raw, dst, 0, 50, 200)
    let a = IO.print(get(out, 2))    # 128 → (128-50)*255/150 = 132
    yield IO.print(length(out))      # 7, the length is preserved
