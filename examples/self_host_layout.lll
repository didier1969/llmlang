module SelfHost.Layout:

  # The indentation layer of the llmlang lexer, written in llmlang and verified by Z3.
  # It reproduces `src/lexer.rs::lex` character for character:
  #
  #   an indentation stack starts at [0]; for every NON-BLANK line
  #     indent >  top   push it, emit one Indent
  #     indent <  top   pop while top > indent, one Dedent per pop, then require top == indent
  #     indent == top   emit nothing
  #   a Newline after every line; at end of input, one Dedent per level above the base
  #
  # A line counts as blank when it holds only spaces, OR only spaces followed by a comment,
  # because the compiler strips `#…` BEFORE testing emptiness. Getting that order wrong makes
  # an indented comment emit a spurious Indent — which is exactly what the last test pins.
  # Line CONTENT is abstract here; only layout emission matters.
  #
  # Two independent recursions, two measures, and deliberately no mutual recursion:
  #
  #   `indentsOf` is NOT structural — it skips a whole line through the opaque call `afterNL`.
  #   Its `measure length(cs)` decreases strictly because peeling the first character gives a
  #   subterm, and `afterNL`'s own `ensures length(result) <= length(cs)` bounds the jump.
  #   Without that contract the measure could not be proved to decrease.
  #
  #   The layout stack (`dropTo`/`dedentsFor`/`closeAll`/`layout`) measures the stack or the
  #   remaining lines, the dedent loop decreasing on the stack.
  #
  # A string is a `List[Int]` of codepoints, and string literals are single-line with no
  # escapes, so multi-line input is assembled explicitly with `10 ::` for each newline.

  type Lay = LIndent | LDedent | LNewline

  # ---- characters to per-line indentation levels ----
  # leading spaces (codepoint 32)
  part leadSp(cs: List[Int]) -> Int:
    match cs:
      []     -> yield 0
      c :: t ->
        match c == 32:
          true  -> yield 1 + leadSp(t)
          false -> yield 0

  # A line of spaces only, up to a newline, end of input, or a comment. The compiler strips
  # `#…` before testing emptiness, so "spaces then a comment" is blank and emits no Indent.
  part blankLine(cs: List[Int]) -> Bool:
    match cs:
      []     -> yield true
      c :: t ->
        match c == 10:
          true  -> yield true
          false ->
            match c == 35:                 # a '#' reached over spaces: comment, so blank
              true  -> yield true
              false ->
                match c == 32:
                  true  -> yield blankLine(t)
                  false -> yield false

  # Everything after the next newline (10), or [] if there is none. The contract is
  # non-strict on purpose: it must also hold for the empty input, and the strict decrease
  # `indentsOf` needs comes from peeling a character, not from here.
  part afterNL(cs: List[Int]) -> List[Int]:
    ensures length(result) <= length(cs)
    match cs:
      []     -> yield []
      c :: t ->
        match c == 10:
          true  -> yield t
          false -> yield afterNL(t)

  # Indentation level per non-blank line. Peeling the first character makes `t` a subterm, and
  # `afterNL`'s bound on its result is what carries that decrease across the opaque call.
  part indentsOf(cs: List[Int]) -> List[Int]:
    measure length(cs)
    match cs:
      []     -> yield []
      c :: t ->
        match c == 10:                       # a bare empty line: skip just the newline
          true  -> yield indentsOf(t)
          false ->
            match blankLine(cs):             # spaces then a newline: blank, skip the line
              true  -> yield indentsOf(afterNL(t))
              false -> yield leadSp(cs) :: indentsOf(afterNL(t))

  # ---- the layout stack ----
  # Pop while the top exceeds `indent`. The base 0 is never popped, since `indent >= 0`.
  part dropTo(stack: List[Int], indent: Int) -> List[Int]:
    measure length(stack)
    match stack:
      []        -> yield []
      x :: rest ->
        match x > indent:
          true  -> yield dropTo(rest, indent)
          false -> yield x :: rest

  # One LDedent per level popped.
  part dedentsFor(stack: List[Int], indent: Int) -> List[Lay]:
    measure length(stack)
    match stack:
      []        -> yield []
      x :: rest ->
        match x > indent:
          true  -> yield LDedent :: dedentsFor(rest, indent)
          false -> yield []

  # At end of input, close every level above the base.
  part closeAll(stack: List[Int]) -> List[Lay]:
    measure length(stack)
    match stack:
      []        -> yield []
      x :: rest ->
        match rest:
          []     -> yield []
          h :: r -> yield LDedent :: closeAll(rest)

  part app(a: List[Lay], b: List[Lay]) -> List[Lay]:
    match a:
      []     -> yield b
      h :: t -> yield h :: app(t, b)

  part appI(a: List[Int], b: List[Int]) -> List[Int]:
    match a:
      []     -> yield b
      h :: t -> yield h :: appI(t, b)

  # Thread the stack through the per-line levels. Transitions are emitted BEFORE the line's
  # Newline, matching the compiler.
  part layout(lines: List[Int], stack: List[Int]) -> List[Lay]:
    measure length(lines)
    match lines:
      []          -> yield closeAll(stack)
      ind :: rest ->
        match stack:
          []           -> yield []
          cur :: srest ->
            match ind > cur:
              true  -> yield LIndent :: (LNewline :: layout(rest, ind :: stack))
              false ->
                match ind < cur:
                  true  -> yield app(dedentsFor(stack, ind), LNewline :: layout(rest, dropTo(stack, ind)))
                  false -> yield LNewline :: layout(rest, stack)

  part lay(src: List[Int]) -> List[Lay]:
    yield layout(indentsOf(src), 0 :: [])

  # ---- differential check ----
  # The signature is a weighted sum per kind (Indent 100, Dedent 10, Newline 1), so it pins how
  # MANY of each kind were emitted. Order is correct by construction, since every line emits its
  # dedents followed by a Newline. Any stack mistake — a missed Indent, one pop too many or too
  # few, an unclosed level at end of input, a blank or comment line counted as content — changes
  # a count and therefore the signature.
  part wl(t: Lay) -> Int:
    match t:
      LIndent  -> yield 100
      LDedent  -> yield 10
      LNewline -> yield 1

  part sigL(ts: List[Lay]) -> Int:
    match ts:
      []     -> yield 0
      h :: t -> yield wl(h) + sigL(t)

  # Three multi-line inputs, assembled explicitly (10 is the newline codepoint).
  # "a:\n  b:\n    c\n  d\ne"  → N I N I N D N D N (indent puis dedent partiel puis dedent) → 225
  part src1() -> List[Int]:
    yield appI("a:", 10 :: appI("  b:", 10 :: appI("    c", 10 :: appI("  d", 10 :: "e"))))

  # "a:\n  b:\n    c\nd"  → N I N I N D D N — two levels closed in one transition → 224
  part src2() -> List[Int]:
    yield appI("a:", 10 :: appI("  b:", 10 :: appI("    c", 10 :: "d")))

  # "a:\n  b:\n    c"  → N I N I N D D — two closing dedents at end of input → 223
  part src3() -> List[Int]:
    yield appI("a:", 10 :: appI("  b:", 10 :: "    c"))

  # The guard on comment handling: a spaces-only line and a spaces-then-comment line must BOTH
  # emit nothing, so this signature has to equal `srcPlain`'s exactly. Were `#…` not stripped
  # before the blankness test, `   # c` would register as an Indent and the two would differ.
  # Signature 112, the same as the version without the blank and comment lines. The `#` (35) is
  # built by codepoint, since a string literal cannot contain one: `#…` is stripped before lexing.
  part srcBlank() -> List[Int]:
    yield appI("a:", 10 :: appI("   ", 10 :: appI("   ", 35 :: appI(" note", 10 :: appI("  b", [])))))

  # "a:\n  b"  → N I N D → 112
  part srcPlain() -> List[Int]:
    yield appI("a:", 10 :: appI("  b", []))

  part main() -> Int via IO:
    let x = IO.print(sigL(lay(src1())))       # 225
    let y = IO.print(sigL(lay(src2())))       # 224
    let z = IO.print(sigL(lay(src3())))       # 223
    let u = IO.print(sigL(lay(srcBlank())))   # 112: the blank and comment lines were skipped
    yield IO.print(sigL(lay(srcPlain())))     # 112, the same, which is the point
