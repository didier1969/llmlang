module Des300k:

  # A round-based simulation whose state is threaded as SCALARS rather than as a record, so the
  # self tail call is eliminated into a loop instead of recursing.
  # 300 000 events, as 100 000 rounds of arrival, start and finish.
  # `served` counts customers through; `0 <= busy <= 1` is an `ensures` on every round.

  part sim(waiting: Int, busy: Int, served: Int, n: Int) -> Int:
    requires waiting >= 0
    requires 0 <= busy, busy <= 1
    requires served >= 0
    requires n >= 0
    ensures result >= 0
    measure n
    match n == 0:
      true  -> yield served
      false -> yield sim(waiting, 0, served + 1, n - 1)

  part main() -> Int via IO:
    yield IO.print(sim(0, 0, 0, 100000))
