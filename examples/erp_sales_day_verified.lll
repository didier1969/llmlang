module ErpSalesDayVerified:

  # A day of sales, with three system guarantees proved TOGETHER over the whole sequence, for
  # any number of sales.
  #
  # Proving one operation correct is the easy half. This module composes three invariants over
  # a LOG of sales — a list of arbitrary length — by structural recursion, which is the step
  # from "this sale is right" to "the day is coherent, whatever the sequence":
  #
  #   margin        no sale, and therefore no day, ends below cost
  #   revenue       the day's revenue is exact and non-negative at symbolic N
  #   double entry  every sale posts a balanced entry, so the day's trial balance is zero
  #
  # None of the three is an assertion checked in production. They are theorems over every
  # possible day: an incoherent one — negative revenue from over-discounting, an unbalanced
  # ledger — cannot be constructed at all.

  type Sale = {price: Int, cost: Int, discount: Int}

  # A sale's net is price less discount, and never falls below cost.
  part sale_net(s: Sale) -> Int:
    requires 0 <= s.cost
    requires s.cost <= s.price
    requires 0 <= s.discount
    requires s.discount <= s.price - s.cost
    ensures result == s.price - s.discount
    ensures result >= s.cost
    ensures result >= 0
    yield s.price - s.discount

  # The day's revenue is the sum of the nets. Non-negativity follows by induction: at `h :: t`
  # the head predicate gives `sale_net(h) >= 0` and the hypothesis gives the same for the tail.
  part day_revenue(sales: List[Sale]) -> Int:
    requires forall s in sales: 0 <= s.cost
    requires forall s in sales: s.cost <= s.price
    requires forall s in sales: 0 <= s.discount
    requires forall s in sales: s.discount <= s.price - s.cost
    ensures result >= 0
    measure length(sales)
    match sales:
      [] -> yield 0
      h :: t -> yield sale_net(h) + day_revenue(t)

  # Each sale debits cash and credits revenue by the SAME net, so its contribution to the trial
  # balance is zero — and therefore the whole day's is, whatever the sequence.
  part sale_posting(s: Sale) -> Int:
    requires 0 <= s.cost
    requires s.cost <= s.price
    requires 0 <= s.discount
    requires s.discount <= s.price - s.cost
    ensures result == 0
    yield sale_net(s) - sale_net(s)

  part day_trial_balance(sales: List[Sale]) -> Int:
    requires forall s in sales: 0 <= s.cost
    requires forall s in sales: s.cost <= s.price
    requires forall s in sales: 0 <= s.discount
    requires forall s in sales: s.discount <= s.price - s.cost
    ensures result == 0
    measure length(sales)
    match sales:
      [] -> yield 0
      h :: t -> yield sale_posting(h) + day_trial_balance(t)

  part main() -> Int via IO:
    # A day of three well-formed sales, each discounted no further than its margin.
    let day = [Sale(100, 60, 10), Sale(200, 120, 50), Sale(80, 50, 0)]
    # Revenue: proved non-negative, and exact at runtime.
    let r = IO.print(day_revenue(day))
    # Trial balance: proved zero, so the books balance.
    yield IO.print(day_trial_balance(day))
