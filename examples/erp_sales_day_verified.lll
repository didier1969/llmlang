module ErpSalesDayVerified:

  # ── DÉMONSTRATEUR : une JOURNÉE de ventes — trois garanties système prouvées ENSEMBLE sur toute
  # la séquence, pour un nombre de ventes QUELCONQUE (CPT-LLL-018) ──
  #
  # Les 18 briques prouvent chacune une forme isolée. Ce module en COMPOSE trois sur un LOG de ventes
  # (une liste), par récurrence structurelle — le passage d'« une opération est correcte » à « la
  # journée entière est cohérente, quelle que soit la séquence » :
  #   1. MARGE — aucune vente, donc aucun jour, ne finit sous le coût (plancher, brique 12) ;
  #   2. REVENU — le revenu de la journée est exact et non-négatif, à N ventes symbolique (brique 8) ;
  #   3. PARTIE DOUBLE — chaque vente poste une écriture équilibrée, donc la balance de vérification
  #      de la journée est nulle, quelle que soit la séquence (invariant inductif de journal, brique 18).
  #
  # AVANT (le réflexe) : traiter les ventes, puis assert(revenue >= 0 && trial_balance == 0) en prod.
  # APRÈS (ici) : ce sont des THÉORÈMES sur toutes les journées possibles — une journée incohérente
  # (revenu négatif par sur-remise, livre déséquilibré) est IMPOSSIBLE à construire.

  type Sale = {price: Int, cost: Int, discount: Int}

  # Brique 12 (plancher de marge) : le net d'une vente = prix − remise, jamais sous le coût.
  part sale_net(s: Sale) -> Int:
    requires 0 <= s.cost
    requires s.cost <= s.price
    requires 0 <= s.discount
    requires s.discount <= s.price - s.cost
    ensures result == s.price - s.discount
    ensures result >= s.cost
    ensures result >= 0
    yield s.price - s.discount

  # 2. REVENU de la journée = somme des nets. Si CHAQUE vente respecte le plancher de marge (toutes
  # bien formées), le revenu du jour est non-négatif — prouvé par récurrence sur un nombre de ventes
  # quelconque : à `h :: t`, le prédicat de tête donne sale_net(h) >= 0 et l'IH donne day_revenue(t) >= 0.
  part day_revenue(sales: List[Sale]) -> Int:
    requires forall s in sales: 0 <= s.cost
    requires forall s in sales: s.cost <= s.price
    requires forall s in sales: 0 <= s.discount
    requires forall s in sales: s.discount <= s.price - s.cost
    ensures result >= 0
    measure length(sales)
    match sales:
      [] -> yield 0
      h :: t -> yield sale_net(h) + day_revenue(t)

  # 3. PARTIE DOUBLE sur la journée : chaque vente débite l'encaissement et crédite les produits du
  # MÊME net → sa contribution à la balance de vérification est nulle. La balance du jour entier est
  # donc nulle, quelle que soit la séquence (brique 18, sur un journal dérivé des ventes).
  part sale_posting(s: Sale) -> Int:
    requires 0 <= s.cost
    requires s.cost <= s.price
    requires 0 <= s.discount
    requires s.discount <= s.price - s.cost
    ensures result == 0
    yield sale_net(s) - sale_net(s)

  part day_trial_balance(sales: List[Sale]) -> Int:
    requires forall s in sales: 0 <= s.cost
    requires forall s in sales: s.cost <= s.price
    requires forall s in sales: 0 <= s.discount
    requires forall s in sales: s.discount <= s.price - s.cost
    ensures result == 0
    measure length(sales)
    match sales:
      [] -> yield 0
      h :: t -> yield sale_posting(h) + day_trial_balance(t)

  part main() -> Int via IO:
    # Une journée de 3 ventes bien formées (remise ≤ marge sur chacune).
    let day = [Sale(100, 60, 10), Sale(200, 120, 50), Sale(80, 50, 0)]
    # Revenu du jour prouvé non-négatif (aucune sur-remise possible), et exact à l'exécution.
    let r = IO.print(day_revenue(day))
    # Balance de vérification du jour prouvée nulle (chaque vente équilibrée) — les livres balancent.
    yield IO.print(day_trial_balance(day))
