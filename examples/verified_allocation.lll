module VerifiedAllocation:

  # Split an amount across N parts without losing or inventing a unit.
  #
  # Distributing a total over invoice lines, cost centres or instalments is where floating
  # point quietly fails: `total / n` per line makes the parts sum to something other than the
  # total, so cents appear or vanish. In exact integers, each part takes
  # `remaining div parts_left`, which absorbs the remainder as it goes, and no two parts ever
  # differ by more than one unit.
  #
  # Conservation — the parts sum to exactly the total — is proved for SYMBOLIC N rather than
  # checked at a few sizes.


  # One part. The upper bound is what discharges the recursive call's precondition below.
  part share(remaining: Int, parts_left: Int) -> Int:
    requires parts_left >= 1
    requires remaining >= 0
    ensures result >= 0
    ensures result <= remaining
    yield remaining div parts_left

  # The proof composes two facts: `share <= remaining` justifies the recursive call, and the
  # induction hypothesis gives the tail's sum, so `share + rest == total`.
  part distribute_sum(total: Int, parts: Int) -> Int:
    requires parts >= 1
    requires total >= 0
    ensures result == total
    measure parts
    yield if parts == 1 then total else share(total, parts) + distribute_sum(total - share(total, parts), parts - 1)

  part main() -> Int via IO:
    # 10000 cents over 7 lines: each part is 1428 or 1429, and they sum back to 10000.
    let s = IO.print(share(10000, 7))          # 1428, the first part
    yield IO.print(distribute_sum(10000, 7))   # 10000, the exact sum of all seven
