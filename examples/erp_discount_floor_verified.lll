module ErpDiscountFloorVerified:

  # A discount can never push the net price below cost.
  #
  # The shape is a FLOOR on a derived value under a guard: given `discount <= price - cost`,
  # the net is proved to stay at or above cost. Selling at a loss is not caught here, it is
  # unrepresentable.


  # Net price, proved at or above cost whenever the discount respects the floor.
  part net_price(price: Int, cost: Int, discount: Int) -> Int:
    requires 0 <= cost
    requires cost <= price
    requires 0 <= discount
    requires discount <= price - cost
    ensures result == price - discount
    ensures result >= cost
    yield price - discount

  # A line's margin, proved non-negative under the same guard.
  part margin(price: Int, cost: Int, discount: Int) -> Int:
    requires 0 <= cost
    requires cost <= price
    requires 0 <= discount
    requires discount <= price - cost
    ensures result >= 0
    ensures result == price - discount - cost
    yield net_price(price, cost, discount) - cost

  # If every line respects its floor, the batch's total margin is non-negative, for any N.
  part total_margin(margins: List[Int]) -> Int:
    requires forall m in margins: m >= 0
    ensures result == sum(margins)
    ensures result >= 0
    measure length(margins)
    match margins:
      [] -> yield 0
      m :: rest -> yield m + total_margin(rest)

  part main() -> Int via IO:
    # Price 100, cost 60, discount 30 (the floor allows 40): net 70, margin 10.
    # A batch of margins [10, 5, 25] totals 40, proved non-negative.
    yield IO.print(total_margin([margin(100, 60, 30), 5, 25]))
