module ErpDiscountFloorVerified:

  # ── AGENT CRITIQUE ERP VÉRIFIÉ : PLANCHER DE MARGE — ne jamais vendre À PERTE (CPT-LLL-018) ──
  #
  # Invariant COMMERCIAL, distinct de la capacité (inventaire) et de l'équilibre (partie double) :
  # un PLANCHER sur une valeur DÉRIVÉE sous une garde. Une remise ne doit JAMAIS pousser le prix
  # net (price − discount) sous le COÛT. Formalisé : `requires discount ≤ price − cost` (la remise
  # ne mord pas dans le coût) ⟹ `ensures net ≥ cost` (marge protégée) — prouvé, pas testé. Vendre
  # à perte est IMPOSSIBLE dans un programme prouvé.

  # Le prix net = prix − remise, prouvé ≥ coût quand la remise respecte le plancher. C'est la
  # garantie « pas de vente à perte », comme théorème, sur une ligne.
  part net_price(price: Int, cost: Int, discount: Int) -> Int:
    requires 0 <= cost
    requires cost <= price
    requires 0 <= discount
    requires discount <= price - cost
    ensures result == price - discount
    ensures result >= cost
    yield price - discount

  # La marge d'une ligne = net − coût, prouvée ≥ 0 (jamais négative) sous le plancher de remise.
  part margin(price: Int, cost: Int, discount: Int) -> Int:
    requires 0 <= cost
    requires cost <= price
    requires 0 <= discount
    requires discount <= price - cost
    ensures result >= 0
    ensures result == price - discount - cost
    yield net_price(price, cost, discount) - cost

  # Somme des marges d'un lot de lignes, toutes ≥ 0 → total ≥ 0 (forall-sur-liste + sum, REQ-201) :
  # si CHAQUE ligne respecte son plancher, la marge TOTALE du lot est prouvée ≥ 0, à N lignes.
  part total_margin(margins: List[Int]) -> Int:
    requires forall m in margins: m >= 0
    ensures result == sum(margins)
    ensures result >= 0
    measure length(margins)
    match margins:
      [] -> yield 0
      m :: rest -> yield m + total_margin(rest)

  part main() -> Int via IO:
    # Prix 100, coût 60, remise 30 (≤ 100−60=40) → net 70 ≥ coût 60, marge ligne 10.
    # Lot de marges [10, 5, 25] toutes ≥ 0 → marge totale 40, prouvée ≥ 0 (aucune vente à perte).
    yield IO.print(total_margin([margin(100, 60, 30), 5, 25]))
