import "../std/option.lll"

depends tokio "1.52.3" features "rt-multi-thread, sync"

module ActorRuntime:

  # A verified actor behaviour running behind an effect boundary, with real parallelism: each
  # actor is its own task owning its own state, never a shared global. None of that is visible
  # to the verified core, which sees only the signatures of `spawn`, `send` and `state`.
  #
  # `state` returns `Option[Int]`, never a fabricated 0. An actor that was stopped, or an
  # unknown identifier, is a first-class ABSENCE the program must handle with a `match` — the
  # process survives, and nothing is silently wrong.
  #
  # Deliberately restricted for now: one fixed behaviour per module, a part named `step` with an
  # imposed signature, and `Int` messages. Passing a behaviour as a VALUE would mean marshalling
  # a function across the foreign frontier, which does not exist yet.


  part max0(x: Int) -> Int:
    ensures result >= 0
    match x >= 0:
      true  -> yield x
      false -> yield 0

  part step(state: Int, msg: Int) -> Int:
    requires state >= 0
    ensures result >= 0
    yield max0(state + msg)

  effect Actor:
    spawn(Int) -> Int               = extern "lll_actor_runtime::spawn"
    send(Int, Int) -> Unit          = extern "lll_actor_runtime::send"
    state(Int) -> Option[Int]       = extern "lll_actor_runtime::state"

  part main() -> Int via Actor, IO:
    let pid1 = Actor.spawn(0)
    let pid2 = Actor.spawn(100)
    let _ = Actor.send(pid1, 5)
    let _ = Actor.send(pid1, 3)
    let _ = Actor.send(pid2, 0 - 50)
    match Actor.state(pid1):         # 0, then +5, then +3
      None -> yield IO.print(0 - 1)  # dead or unknown actor: handled, never silent
      Some(s1) ->
        match Actor.state(pid2):     # 100, then -50
          None -> yield IO.print(0 - 1)
          Some(s2) -> yield IO.print(s1 + s2)   # 8 + 50
