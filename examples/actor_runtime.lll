depends tokio "1.52.3" features "rt-multi-thread, sync"

module ActorRuntime:

  # REQ-LLL-036 W2-t2 (voie 2a CPT-LLL-014, design CPT-LLL-015) : le
  # comportement d'acteur (step, prouvé en W0 — examples/actor_reactive.lll)
  # vit DERRIÈRE une frontière d'effet, avec un VRAI parallélisme maintenant :
  # chaque acteur est sa propre tâche Tokio, possédant SON état (plus de mutex
  # global partagé, src/codegen.rs `emit_actor_runtime`) — jamais vu par le
  # cœur vérifié (havoc à la frontière, DEC-LLL-017 : Z3 ne voit jamais ce que
  # `spawn`/`send`/`state` font réellement, seulement leur signature).
  #
  # v1 délibérément restreint (inchangé depuis la tranche 1, CPT-LLL-015 §9) :
  # UN SEUL comportement fixe par module (une part nommée `step`, signature
  # imposée `(Int, Int) -> Int`) — passer un comportement EN VALEUR à `spawn`
  # nécessiterait de marshaller une fonction à la frontière FFI, ce qui
  # n'existe pas encore. Messages `Int` seulement, même raison. Aucune
  # isolation de fautes explicite encore (au-delà de ce que Tokio isole par
  # tâche gratuitement) — `catch_unwind`/politique de redémarrage est W2-t2b,
  # un incrément séparé.

  part max0(x: Int) -> Int:
    ensures result >= 0
    match x >= 0:
      true  -> yield x
      false -> yield 0

  part step(state: Int, msg: Int) -> Int:
    requires state >= 0
    ensures result >= 0
    yield max0(state + msg)

  effect Actor:
    spawn(Int) -> Int       = extern "lll_actor_runtime::spawn"
    send(Int, Int) -> Unit  = extern "lll_actor_runtime::send"
    state(Int) -> Int       = extern "lll_actor_runtime::state"

  part main() -> Int via Actor, IO:
    let pid1 = Actor.spawn(0)
    let pid2 = Actor.spawn(100)
    let _ = Actor.send(pid1, 5)
    let _ = Actor.send(pid1, 3)
    let _ = Actor.send(pid2, 0 - 50)
    let s1 = Actor.state(pid1)   # 0 -> +5=5 -> +3=8
    let s2 = Actor.state(pid2)   # 100 -> +(-50)=50
    yield IO.print(s1 + s2)      # 8 + 50 = 58
