module PureCallCse:

  # Two syntactically identical PURE calls are recognised as the same term.
  #
  # `eval(b)` appears both in the guard and as the divisor. Because the call is pure, the guard
  # `eval(b) == 0` propagates `eval(b) != 0` to the division, and the division-by-zero
  # obligation discharges without binding the result to a `let` first.
  #
  # Without that recognition each call would be havocked into its own fresh constant, nothing
  # would connect the two, and this would be rejected.


  type Expr = Lit(Int) | Dv(Expr, Expr)

  part eval(e: Expr) -> Int:
    match e:
      Lit(n)   -> yield n
      Dv(a, b) ->
        match eval(b) == 0:
          true  -> yield 0
          false -> yield eval(a) div eval(b)     # safe: the guard covers this same term

  part main() -> Int via IO:
    let x = IO.print(eval(Dv(Lit(12), Lit(4))))   # 3
    yield IO.print(eval(Dv(Lit(7), Lit(0))))      # 0, caught by the guard
