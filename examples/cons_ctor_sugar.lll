module ConsCtorSugar:

  # Matching a constructor directly in the HEAD of a cons pattern.
  #
  # The common shape in a parser or lexer is to dispatch on the head of a token list. Written
  # out, every step costs a nested match and a level of indentation:
  #
  #     h :: rest -> match h: TPlus -> … ; TMinus -> … ; _ -> …
  #
  # The flat multi-arm form below desugars at parse time into exactly that, producing the same
  # AST and therefore the same content hash — the sugar is invisible to identity. Exhaustiveness
  # is re-checked independently on the desugared form, so the sugar cannot invent coverage it
  # does not have.


  type Tok = TNum(Int) | TPlus | TMinus | TLParen | TRParen

  # A contiguous group of constructor heads sharing the same tail, closed by a default arm.
  # The default's binder becomes the inner scrutinee, so no body is rewritten: `n` is bound by
  # its own pattern, `rest` by the cons, and the default arm never touches the head.
  part leadPrec(toks: List[Tok]) -> Int:
    ensures result >= 0
    match toks:
      []              -> yield 0
      TNum(n) :: rest -> yield 3
      TPlus :: rest   -> yield 1
      TMinus :: rest  -> yield 1
      other :: rest   -> yield 0     # a parenthesis: not a binary operator

  # Without a default arm the coverage must be exhaustive over the head's type, or it does not
  # compile. All five constructors are listed here.
  part isCloser(toks: List[Tok]) -> Bool:
    match toks:
      []           -> yield false
      TNum(n) :: r -> yield false
      TPlus :: r   -> yield false
      TMinus :: r  -> yield false
      TLParen :: r -> yield false
      TRParen :: r -> yield true

  part main() -> Int via IO:
    let a = IO.print(leadPrec(TPlus :: TNum(2) :: []))   # head is TPlus
    let b = IO.print(leadPrec(TNum(7) :: []))            # head is TNum
    yield IO.print(leadPrec(TRParen :: []))              # head falls to the default
