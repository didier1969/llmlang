module ErpPlanningVerified:

  # Production planning whose feasibility is proved, not assumed.
  #
  # A solver proposes a production plan. It is an ORACLE at the effect boundary: its result is
  # havocked, so the verified core knows nothing about what came back. `feasible` re-checks
  # every constraint — non-negativity, per-product demand ceilings, shared machine capacity —
  # and a plan violating any one of them is rejected before any profit is computed.
  #
  # The problem: three products share one machine with 100 machine-hours over the horizon.
  #
  #   product          hours/unit   margin/unit   max demand
  #   Widget (sol[0])       2          500 c          20
  #   Gadget (sol[1])       3          400 c          15
  #   Gizmo  (sol[2])       1          150 c          30
  #
  # Maximise total margin subject to those ceilings and 2W + 3G + 1Z <= 100. The exact integer
  # optimum is 20 / 10 / 30 for 18500 c: Widget returns 250 c per machine-hour and Gizmo 150,
  # so both saturate their demand, and Gadget absorbs the 30 hours left.

  # The oracle. Its result is havocked, and that wall is what forces the re-check below.
  effect Solver:
    solve(List[Int]) -> List[Int] = extern "lll_solver_runtime::solve"

  # Reify the plan as an array so contracts can index it and use `length`. The array stays
  # opaque to the prover, so the conversion does not weaken the havoc wall.
  part to_array(xs: List[Int], acc: Array[Int]) -> Array[Int]:
    match xs:
      []     -> yield acc
      h :: t -> yield to_array(t, push(acc, h))

  # The witness check. Indices are Widget, Gadget, Gizmo in order. On the `true` branch below,
  # the contract firewall assumes this `ensures`, and that conjunction is what discharges
  # `use_plan`'s preconditions — the solver's own model discharges nothing.
  part feasible(sol: Array[Int]) -> Bool:
    requires length(sol) == 3
    ensures result == (get(sol, 0) >= 0 and get(sol, 1) >= 0 and get(sol, 2) >= 0 and get(sol, 0) <= 20 and get(sol, 1) <= 15 and get(sol, 2) <= 30 and get(sol, 0) * 2 + get(sol, 1) * 3 + get(sol, 2) <= 100)
    yield get(sol, 0) >= 0 and get(sol, 1) >= 0 and get(sol, 2) >= 0 and get(sol, 0) <= 20 and get(sol, 1) <= 15 and get(sol, 2) <= 30 and get(sol, 0) * 2 + get(sol, 1) * 3 + get(sol, 2) <= 100

  # Total profit in cents. Because `sol` came from the havocked oracle, these preconditions
  # can only be discharged through the witness check — nothing else in scope knows anything
  # about it.
  part use_plan(sol: Array[Int]) -> Int:
    requires length(sol) == 3
    requires get(sol, 0) >= 0 and get(sol, 1) >= 0 and get(sol, 2) >= 0
    requires get(sol, 0) <= 20 and get(sol, 1) <= 15 and get(sol, 2) <= 30
    requires get(sol, 0) * 2 + get(sol, 1) * 3 + get(sol, 2) <= 100
    ensures result >= 0
    yield get(sol, 0) * 500 + get(sol, 1) * 400 + get(sol, 2) * 150

  part main() -> Int via Solver, IO:
    # Solver-agnostic flat encoding, laid out as:
    #   [nvars, ncons, sense, objective coefficients.., then per constraint: rel, rhs, coeffs..]
    #   sense: 0 = minimise, 1 = maximise      rel: 0 = `<=`, 1 = `>=`, 2 = `==`
    # Here: 3 variables and 7 constraints — three non-negativities, three demand ceilings, one
    # machine capacity.
    let model = [3, 7, 1, 500, 400, 150, 1, 0, 1, 0, 0, 1, 0, 0, 1, 0, 1, 0, 0, 0, 1, 0, 20, 1, 0, 0, 0, 15, 0, 1, 0, 0, 30, 0, 0, 1, 0, 100, 2, 3, 1]
    let sol = to_array(Solver.solve(model), array())
    # Length is re-checked at runtime: an oracle returning the wrong number of products, or
    # nothing when it fails, takes the `false` branch and never reaches the profit.
    match length(sol) == 3:
      true ->
        match feasible(sol):
          true  -> yield IO.print(use_plan(sol))   # profit optimal = 18500 centimes (185,00 €)
          false -> yield IO.print(0 - 1)           # infeasible plan, rejected
      false -> yield IO.print(0 - 2)               # wrong number of products, rejected
