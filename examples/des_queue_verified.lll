module DesQueueVerified:

  # ── SONDE : un moteur de SIMULATION À ÉVÉNEMENTS DISCRETS (équivalent SimPy) en llmlang pur ──
  #
  # SimPy = coroutines qui se suspendent/reprennent. llmlang est purement fonctionnel → on utilise la
  # WORLD-VIEW event-scheduling : un état {temps, en_file, occupé}, et on avance en traitant, à chaque
  # pas, l'événement le plus proche (arrivée ou fin-de-service). Le stochastique de SimPy est ici
  # DÉTERMINISTE (inter-arrivée / durée-service fixes) — un langage vérifié et l'aléatoire sont en
  # tension ; on garde le déterminisme pour que la simulation soit REPRODUCTIBLE et PROUVABLE.
  #
  # L'INVARIANT QUE LA VÉRIFICATION ACHÈTE (ce que SimPy NE prouve pas, ne fait que tester) : le
  # serveur n'est JAMAIS sur-occupé au-delà de sa capacité (busy <= cap), et la file ne devient jamais
  # négative — à TOUT instant de TOUTE trajectoire, prouvé par récurrence sur le nombre de pas.

  type Sim = {waiting: Int, busy: Int}

  # Capacité serveur = 1 (une file M/M/1). Un pas de simulation : soit une ARRIVÉE (waiting+1), soit un
  # DÉBUT-SERVICE (si le serveur est libre et qu'il y a un client : waiting-1, busy=1), soit une
  # FIN-SERVICE (busy=0). Chaque transition PRÉSERVE l'invariant 0<=busy<=1 et waiting>=0.

  part arrive(s: Sim) -> Sim:
    requires s.waiting >= 0
    requires 0 <= s.busy, s.busy <= 1
    ensures result.waiting >= 0
    ensures 0 <= result.busy, result.busy <= 1
    yield Sim(s.waiting + 1, s.busy)

  part start_service(s: Sim) -> Sim:
    requires s.waiting >= 0
    requires 0 <= s.busy, s.busy <= 1
    ensures result.waiting >= 0
    ensures 0 <= result.busy, result.busy <= 1
    match s.busy == 0:
      false -> yield s
      true ->
        match s.waiting >= 1:
          false -> yield s
          true  -> yield Sim(s.waiting - 1, 1)

  part finish_service(s: Sim) -> Sim:
    requires s.waiting >= 0
    requires 0 <= s.busy, s.busy <= 1
    ensures result.waiting >= 0
    ensures 0 <= result.busy, result.busy <= 1
    yield Sim(s.waiting, 0)

  # LE PLANIFICATEUR : rejouer une trajectoire d'événements encodés (0=arrivée, 1=start, 2=finish) sur
  # l'état initial. L'invariant no-overload tient sur TOUTE la trajectoire, à N pas symbolique — un
  # THÉORÈME, pas un assert de fin de simulation.
  part run_events(s: Sim, events: List[Int]) -> Sim:
    requires s.waiting >= 0
    requires 0 <= s.busy, s.busy <= 1
    ensures result.waiting >= 0
    ensures 0 <= result.busy, result.busy <= 1
    measure length(events)
    match events:
      [] -> yield s
      e :: rest ->
        match e == 0:
          true  -> yield run_events(arrive(s), rest)
          false ->
            match e == 1:
              true  -> yield run_events(start_service(s), rest)
              false -> yield run_events(finish_service(s), rest)

  part main() -> Int via IO:
    # Trajectoire : 3 arrivées, 3 (start,finish) → tous servis. On imprime la file finale (0) — et le
    # fait que ça COMPILE prouve que busy n'a jamais dépassé 1 sur toute la trajectoire.
    let s0 = Sim(0, 0)
    let final = run_events(s0, [0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 