import "../std/option.lll"

depends tokio "1.52.3" features "rt-multi-thread, sync"

module ActorReactiveIntegrated:

  # Several verified actors plus a reactive delta view, driven by the real runtime and replayable
  # exactly. There is no new machinery here — only the wiring: after each message, `main`
  # recomputes the view and the delta from the actor's real state, read across the effect
  # boundary.
  #
  # `state` returns `Option[Int]`, so a stopped actor or an unknown identifier is a `None` that
  # every read must handle, never a fabricated 0.


  type Delta = NoChange | Changed(Int)

  part max0(x: Int) -> Int:
    ensures result >= 0
    match x >= 0:
      true  -> yield x
      false -> yield 0

  # The actor behaviour: total, proved, and effect-free.
  part step(state: Int, msg: Int) -> Int:
    requires state >= 0
    ensures result >= 0
    yield max0(state + msg)

  # The view: a pure derivation, usable without any runtime.
  part view(state: Int) -> Int:
    yield state * 2

  # The minimal delta, proved on the decidable question of WHETHER it changed.
  part diff(old_view: Int, new_view: Int) -> Delta:
    ensures (old_view == new_view) == (result == NoChange)
    example diff(0, 0) == NoChange
    example diff(0, 6) != NoChange
    match old_view == new_view:
      true  -> yield NoChange
      false -> yield Changed(new_view)

  effect Actor:
    spawn(Int) -> Int          = extern "lll_actor_runtime::spawn"
    send(Int, Int) -> Unit     = extern "lll_actor_runtime::send"
    state(Int) -> Option[Int]  = extern "lll_actor_runtime::state"

  # The driver: after each message reaches the real runtime, read the state back, compute the
  # view, and diff it against the previous one — pushing only when it changed. Every read
  # handles absence explicitly.
  part main() -> Int via Actor, IO:
    let pid = Actor.spawn(0)
    match Actor.state(pid):
      None -> yield IO.print(0 - 1)
      Some(s0) ->
        let v0 = view(s0)
        let _ = Actor.send(pid, 5)
        match Actor.state(pid):
          None -> yield IO.print(0 - 1)
          Some(s1) ->
            let v1 = view(s1)
            let d1 = diff(v0, v1)
            let _ = Actor.send(pid, 3)
            match Actor.state(pid):
              None -> yield IO.print(0 - 1)
              Some(s2) ->
                let v2 = view(s2)
                let d2 = diff(v1, v2)
                match d1:
                  Changed(x) -> yield IO.print(x)   # the view moved from 0 to 10
                  NoChange   -> yield IO.print(0 - 1)
